{
  "buildId": "demo-0001",
  "entry": {
    "route": "/invoices/:invoiceId"
  },
  "id": "send-invoice",
  "kind": "steppy-tour",
  "locale": "fr",
  "schema": 1,
  "steps": [
    {
      "advance": {
        "on": "input"
      },
      "id": "send-to",
      "target": "send-to",
      "text": "Saisissez l'adresse e-mail du destinataire et un court message.",
      "title": "Destinataire et message"
    },
    {
      "advance": {
        "on": "input"
      },
      "id": "send-message",
      "target": "send-message",
      "text": "Saisissez l'adresse e-mail du destinataire et un court message.",
      "title": "Destinataire et message"
    },
    {
      "advance": {
        "on": "click"
      },
      "id": "send-invoice-btn",
      "target": "send-invoice-btn",
      "text": "Cliquez sur **Envoyer**."
    },
    {
      "advance": {
        "on": "manual"
      },
      "id": "invoice-status",
      "target": "invoice-status",
      "text": "Le statut passe à **Envoyée**.",
      "title": "Envoyée"
    }
  ],
  "title": "Envoyer une facture"
}
