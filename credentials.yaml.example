# credentials.yaml — LOCAL, GIT-IGNORED credential overlay.
#
# Copy this file to `credentials.yaml` (same directory as config.yaml) and fill
# in real values. It is deep-merged ON TOP of config.yaml at load time, so it
# only needs the `apps.<role>.auth.credentials` blocks you want to override —
# everything else is inherited from config.yaml.
#
# `credentials.yaml` is listed in .gitignore and must never be committed. Prefer
# this file (or ${ENV_VAR} references in config.yaml) over inline plaintext
# secrets. See SECURITY.md for the full credential-handling guidance.
#
# You can ALSO keep credentials.yaml env-referenced if you like — the same
# ${VAR} / ${VAR:-default} interpolation applies to this overlay.

apps:
  admin:
    auth:
      credentials:
        username: "test-admin@example.com"
        password: "change-me"
        # Optional TOTP/MFA shared secret (base32). Pair with a
        # `auth.form.totp_selector` in config.yaml for automated MFA login.
        # totp_secret: "${STEPPY_ADMIN_TOTP}"
  editor:
    auth:
      credentials:
        username: "test-editor@example.com"
        password: "change-me"
  viewer:
    auth:
      credentials:
        username: "test-viewer@example.com"
        password: "change-me"
