{
  "name": "@steppy/player",
  "version": "0.4.0",
  "description": "Steppy players — the interactive guide (Lit web component + manifest validator) and the in-app tour overlay",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Steppy-dev/steppy.git",
    "directory": "packages/player"
  },
  "type": "module",
  "main": "./dist/steppy-player.js",
  "module": "./dist/steppy-player.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "default": "./dist/steppy-player.js"
    },
    "./schema.json": "./schema/guide.schema.json",
    "./tour": {
      "types": "./dist/types/tour/index.d.ts",
      "default": "./dist/steppy-tour.js"
    }
  },
  "typesVersions": {
    "*": {
      "tour": [
        "./dist/types/tour/index.d.ts"
      ]
    }
  },
  "sideEffects": true,
  "files": [
    "dist",
    "schema",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && vite build -c vite.iife.config.ts && vite build -c vite.video.config.ts && npm run build:tour && npm run build:schema",
    "build:esm": "vite build",
    "build:iife": "vite build -c vite.iife.config.ts",
    "build:video": "vite build -c vite.video.config.ts",
    "build:tour": "vite build -c vite.tour.config.ts && npm run build:types",
    "build:schema": "tsx scripts/emit-json-schema.ts",
    "size:tour": "tsx scripts/check-tour-size.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "check:pack": "tsx scripts/check-pack.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "lit": "^3.2.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "happy-dom": "^15.7.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "zod-to-json-schema": "^3.23.0"
  }
}
