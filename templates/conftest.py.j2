def _form_selectors() -> dict:
    """Merge the login-form selector defaults, the named IdP ``preset:`` and the
    configured overrides, explicit keys winning as they do in ``FormAuthConfig``.

    CONFIG here is raw YAML, so the preset has to be resolved here: left alone,
    ``preset: keycloak`` would keep the Auth0 defaults. Accepts both the current
    ``auth.form`` block and the legacy ``auth.auth0`` key (mode ``auth0`` was
    renamed ``form`` in FLAWS §6.2, so both spellings can still reach us)."""
    auth = CONFIG.get("auth", {})
    overrides = dict(auth.get("form") or auth.get("auth0") or {})
    preset = overrides.pop("preset", None)
    if preset is None:
        return {**_FORM_DEFAULTS, **overrides}
    if preset not in _IDP_FORM_PRESETS:
        raise ValueError(f"Unknown auth.form preset {preset!r}; available: {sorted(_IDP_FORM_PRESETS)}")
    return {**_FORM_DEFAULTS, **_IDP_FORM_PRESETS[preset], **overrides}


