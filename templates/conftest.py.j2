# Role page-fixture names, baked from the project's roles. Used by the
# scenario-layout parametrization hook to spot which fixtures to parametrize.
_PAGE_FIXTURES = {
{%- for role in roles %}
    "{{ role }}_page", "{{ role }}_page_noauth",
{%- endfor %}
}


def _effective_run_layouts(scenario_layouts):
    """Resolve the layout dimension for one scenario module.

    ``scenario_layouts`` is the module's baked ``SCENARIO_LAYOUTS`` (``None``
    when the scenario declares none). Semantics:
      * no declaration -> ``LAYOUTS_FOR_RUN`` unchanged (byte-identical default).
      * declaration + no run-level ``--layouts`` (``LAYOUTS_FOR_RUN == [None]``)
        -> the declaration is authoritative (a plain ``steppy run`` parametrizes
        the whole flow over its declared layouts).
      * declaration + run-level ``--layouts`` -> intersection in run-selected
        order (``--layouts``/``--guide`` filters the declared set).
    An empty result means the scenario's declaration is disjoint from the run
    selection; ``pytest_collection_modifyitems`` deselects those scenarios."""
    if not scenario_layouts:
        return LAYOUTS_FOR_RUN
    if LAYOUTS_FOR_RUN == [None]:
        return list(scenario_layouts)
    return [l for l in LAYOUTS_FOR_RUN if l in scenario_layouts]


def pytest_generate_tests(metafunc):
    """Own the (locale x layout) parametrization of the role page fixtures so a
    per-scenario ``SCENARIO_LAYOUTS`` can narrow (or, on a plain run, drive) the
    layout dimension. Modules with no declaration yield exactly
    ``_locale_layout_params()`` -> collection identical to the pre-feature run.

    Every role page a test requests is bound under ONE ``parametrize`` call, so
    the roles move in lockstep: a two-role scenario runs once per (locale,
    layout), not once per pairing of each role's (locale, layout). Separate
    calls on independent argnames multiply, and the mixed items were not just
    redundant but wrong — ``CURRENT_LOCALE``/``CURRENT_LAYOUT`` are one global
    every role fixture writes, so the last one set up decided the screenshot
    directory for pages that were built at the other role's viewport."""
    page_fixtures = [f for f in metafunc.fixturenames if f in _PAGE_FIXTURES]
    if not page_fixtures:
        return
    scenario_layouts = getattr(metafunc.module, "SCENARIO_LAYOUTS", None)
    if not scenario_layouts:
        params = _locale_layout_params()
    else:
        layouts = _effective_run_layouts(scenario_layouts)
        if not layouts:
            # Declaration disjoint from the run selection: leave the fixtures
            # unparametrized (an empty parametrize + id callable would crash on
            # pytest's empty-set sentinel) — pytest_collection_modifyitems
            # deselects the item before any fixture runs.
            return
        params = [(locale, layout) for locale in LOCALES_FOR_RUN for layout in layouts]
    if len(page_fixtures) == 1:
        # A string argname makes pytest wrap each value itself, so request.param
        # stays the bare (locale, layout) tuple and single-role ids are unchanged.
        metafunc.parametrize(page_fixtures[0], params, ids=_locale_layout_id, indirect=True)
        return
    # An id callable would be applied to each argname's value and the results
    # hyphen-joined (``fr-mobile-fr-mobile``), hence one precomputed id per set.
    metafunc.parametrize(
        page_fixtures,
        [tuple(p for _ in page_fixtures) for p in params],
        ids=[_locale_layout_id(p) for p in params],
        indirect=True,
    )


def pytest_collection_modifyitems(config, items):
    """Silently deselect scenarios whose declared layouts are disjoint from the
    run's selected layouts (e.g. ``--layouts mobile`` against a desktop-only
    scenario); otherwise they'd surface as a spurious 'empty parameter set' skip.
    No-op when no run-level layout selection is active (nothing can be disjoint)."""
    if LAYOUTS_FOR_RUN == [None]:
        return
    kept, removed = [], []
    for item in items:
        scenario_layouts = getattr(item.module, "SCENARIO_LAYOUTS", None)
        if scenario_layouts and not _effective_run_layouts(scenario_layouts):
            removed.append(item)
        else:
            kept.append(item)
    if removed:
        config.hook.pytest_deselected(items=removed)
        items[:] = kept


def _resolve_browser_locale(role: str) -> "str | None":
    """Pick the Playwright BrowserContext locale for ``role``.

    ``--guide`` runs pass ``STEPPY_LOCALES`` and parametrize the role fixture
    over those values, setting ``CURRENT_LOCALE`` per parametrization — that
    wins, so internationalized captures render dates / numbers in the locale
    they're being captured for. Otherwise the static ``apps.<role>.locale``
    from config.yaml is used (makes test runs deterministic regardless of host
    OS or container locale). Returns ``None`` when neither is set — Playwright
    then uses the browser default (historic behaviour, backwards-compatible).
    """
    if CURRENT_LOCALE:
