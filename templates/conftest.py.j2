def _maybe_start_trace(context: BrowserContext) -> None:
    """Start tracing on the context when trace mode is enabled (no-op if off)."""
    if not TRACE_MODE:
        return
    try:
        context.tracing.start(screenshots=True, snapshots=True, sources=True)
    except Exception:
        pass  # tracing is a debug aid; never let it break the test


def _maybe_stop_trace(context: BrowserContext, request) -> None:
    """Stop tracing and, for ``on`` (always) or ``on-failure`` (only failures),
    save ``output/traces/<nodeid>.zip``. ``_steppy_call_failed`` is stamped by
    ``pytest_runtest_makereport`` before fixture teardown."""
    if not TRACE_MODE:
        return
    failed = getattr(request.node, "_steppy_call_failed", False)
    keep = TRACE_MODE == "on" or (TRACE_MODE == "on-failure" and failed)
    try:
        if keep:
            TRACES_DIR.mkdir(parents=True, exist_ok=True)
            path = TRACES_DIR / f"{_sanitise_nodeid(request.node.nodeid)}.zip"
            context.tracing.stop(path=str(path))
            print(f"\n[steppy] trace: {path}", flush=True)
        else:
            context.tracing.stop()
    except Exception:
        pass


# ── Playwright video (FLAWS §6.1) ─────────────────────────────────────────────

def _video_context_kwargs() -> dict:
    """`record_video_dir=` kwargs for `new_context` when video is on (else {}).

    Unlike tracing (started on the returned context), video must be requested at
    context-construction time, so this is spliced into every `new_context(...)`.
    When off it returns {} → the call is byte-identical to the pre-feature form."""
    if not VIDEO_MODE:
        return {}
    VIDEOS_DIR.mkdir(parents=True, exist_ok=True)
    return {"record_video_dir": str(VIDEOS_DIR)}


def _maybe_save_video(video, request) -> None:
    """Keep (``on`` / failed ``on-failure``) or drop the recorded video.

    ``video`` is the ``page.video`` handle captured before the page/context were
    closed; Playwright finalizes the file on context close, so this runs after."""
    if not video:
        return
    failed = getattr(request.node, "_steppy_call_failed", False)
    keep = VIDEO_MODE == "on" or (VIDEO_MODE == "on-failure" and failed)
    try:
        if keep:
            path = VIDEOS_DIR / f"{_sanitise_nodeid(request.node.nodeid)}.webm"
            video.save_as(str(path))
            print(f"\n[steppy] video: {path}", flush=True)
        video.delete()
    except Exception:
        pass


