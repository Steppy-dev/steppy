def _step_runs(only_in, layouts):
    """Return False when a step's ``only-in`` / ``layouts`` filters exclude it
    from the current run. Centralises the predicate so generated test files can
    just call ``if _step_runs(...): <body>``.

    - ``only-in: test`` → skip in guide mode
    - ``only-in: guide`` → skip outside guide mode
    - ``layouts: [...]`` → step runs iff the active layout is in the whitelist.
      The active layout is ``CURRENT_LAYOUT`` when a layout is parametrized,
      otherwise ``DEFAULT_TEST_LAYOUT`` (the default Playwright viewport is
      desktop-sized, so a step gated to ``layouts: [mobile]`` is skipped in
      plain test mode).
    """
    if only_in == "test" and GUIDE_MODE:
        return False
    if only_in == "guide" and not GUIDE_MODE:
        return False
    if layouts:
        active = CURRENT_LAYOUT or DEFAULT_TEST_LAYOUT
        if active not in layouts:
            return False
    return True


