def _login_settle(page: Page, timeout: int = 15000) -> None:
    """Let the page settle after a login submit, per ``timing.navigate_wait``.

    The login used to wait for ``networkidle`` unconditionally, which an app
    that holds an EventSource or a WebSocket open never reaches. ``none`` skips
    the wait, as it does on ``navigate``.
    """
    strategy = _navigate_wait()
    if strategy != "none":
        page.wait_for_load_state(strategy, timeout=timeout)


def _open_login_form(page: Page, form: dict) -> None:
    """Wait for the provider's username field, first clicking through the
    app's own login page when ``auth.form.start_selector`` names its button.

    Either page may be the one showing (a session can land on the provider
    directly), so wait for whichever appears and click only the app's.
    """
    start = form.get("start_selector")
    if start:
        username = page.locator(form["username_selector"])
        username.or_(page.locator(start)).first.wait_for(timeout=15000)
        if not username.first.is_visible():
            page.locator(start).first.click()
    page.wait_for_selector(form["username_selector"], timeout=15000)


def _fill_totp(page: Page, form: dict, credentials: dict) -> None:
    """Fill a TOTP/MFA code after the password submit, when configured (FLAWS §6.2).

    No-op unless both ``auth.form.totp_selector`` and the app credentials'
    ``totp_secret`` are set. Tolerates a missing prompt (trusted device)."""
    totp_selector = form.get("totp_selector")
    totp_secret = credentials.get("totp_secret")
    if not totp_selector or not totp_secret:
        return
    try:
        page.wait_for_selector(totp_selector, timeout=10000)
    except Exception:
        return  # no MFA prompt this session — nothing to fill
    page.fill(totp_selector, _totp_now(totp_secret))
    submit = form.get("totp_submit_selector") or form["submit_selector"]
    page.locator(submit).click()
    _login_settle(page)


def fill_login_credentials(page: Page, role: str) -> None:
    """Fill the hosted login form with credentials from config. Call after the
    login page (the app's own, with ``start_selector`` set, or the provider's)
    appears.

    Handles both single-page and two-step (identifier-first) flows. Works
    against any IdP (Auth0, Keycloak, …) via the ``auth.form`` selectors.
    """
    app = CONFIG["apps"][role]
    form = _form_selectors()

    # Step 1: Fill username / email
    _open_login_form(page, form)
    page.fill(form["username_selector"], app["auth"]["credentials"]["username"])

    # Check if password field is already visible (single-page flow)
    pwd_visible = page.locator(form["password_selector"]).is_visible()

    if pwd_visible:
        # Single-page: fill password and submit once
        page.fill(form["password_selector"], app["auth"]["credentials"]["password"])
        page.locator(form["submit_selector"]).click()
        _login_settle(page)
    else:
        # Two-step (identifier-first): submit username, wait for password field
        page.locator(form["submit_selector"]).click()
        page.wait_for_selector(form["password_selector"], timeout=15000)
        page.fill(form["password_selector"], app["auth"]["credentials"]["password"])
        page.locator(form["submit_selector"]).click()
        _login_settle(page)

    # Optional TOTP/MFA step (no-op unless configured)
    _fill_totp(page, form, app["auth"]["credentials"])

    # Handle optional consent screen
    consent = form.get("consent_selector")
    if consent:
        try:
            page.wait_for_selector(consent, timeout=3000)
            page.click(consent)
        except Exception:
            pass

    # Logged in once the app is back, when the project says what that looks like.
    pattern = form.get("post_login_url_pattern")
    if pattern:
        page.wait_for_url(pattern, timeout=15000)


