_INSECURE_ORIGIN_POLYFILL = r"""
// Steppy parallel-mode polyfill: make a Docker-internal HTTP origin look
// like a secure context to the Auth0 SPA SDK (and any other library that
// gates on Web Crypto).
//
// Background: browsers only treat HTTPS / localhost / 127.0.0.1 / *.localhost
// as secure contexts. ``http://editor-frontend`` reached through Docker DNS
// is not. The standard escape hatch — Chromium's
// ``--unsafely-treat-insecure-origin-as-secure`` flag — is silently
// ignored by Playwright's headless Chromium because Playwright doesn't
// create the ``Local State`` file Chromium reads for that flag (see
// microsoft/playwright#22944 and #27768). The flag fix is therefore not
// available to us; we patch the runtime instead.
//
// What we polyfill:
//   * ``window.isSecureContext`` → true   (some libs check this directly)
//   * ``window.crypto.subtle.digest('SHA-256', data)``  (the only Web
//     Crypto operation @auth0/auth0-spa-js performs — PKCE challenge
//     generation. Token-signature verification is server-side; the SDK
//     just decodes the JWT to read claims and trusts the back-channel
//     token-exchange response.)
//
// Pure-JS FIPS 180-2 SHA-256. Returns a Promise<ArrayBuffer> so the
// signature matches the real Web Crypto API; auth0-spa-js does
// ``await crypto.subtle.digest(...)``.
(() => {
  try {
    Object.defineProperty(window, 'isSecureContext', {
      configurable: true, get: () => true,
    });
  } catch (e) { /* readonly in some builds; not fatal */ }

  const K = new Uint32Array([
    0x428a2f98,0x71374491,0xb5c0fbcf,0xe9b5dba5,0x3956c25b,0x59f111f1,0x923f82a4,0xab1c5ed5,
    0xd807aa98,0x12835b01,0x243185be,0x550c7dc3,0x72be5d74,0x80deb1fe,0x9bdc06a7,0xc19bf174,
    0xe49b69c1,0xefbe4786,0x0fc19dc6,0x240ca1cc,0x2de92c6f,0x4a7484aa,0x5cb0a9dc,0x76f988da,
    0x983e5152,0xa831c66d,0xb00327c8,0xbf597fc7,0xc6e00bf3,0xd5a79147,0x06ca6351,0x14292967,
    0x27b70a85,0x2e1b2138,0x4d2c6dfc,0x53380d13,0x650a7354,0x766a0abb,0x81c2c92e,0x92722c85,
    0xa2bfe8a1,0xa81a664b,0xc24b8b70,0xc76c51a3,0xd192e819,0xd6990624,0xf40e3585,0x106aa070,
    0x19a4c116,0x1e376c08,0x2748774c,0x34b0bcb5,0x391c0cb3,0x4ed8aa4a,0x5b9cca4f,0x682e6ff3,
    0x748f82ee,0x78a5636f,0x84c87814,0x8cc70208,0x90befffa,0xa4506ceb,0xbef9a3f7,0xc67178f2,
  ]);
  const rotr = (x, n) => ((x >>> n) | (x << (32 - n))) >>> 0;

  function sha256(bytes) {
    const len = bytes.length;
    const padded = new Uint8Array(((len + 9 + 63) >> 6) << 6);
    padded.set(bytes);
    padded[len] = 0x80;
    const dv = new DataView(padded.buffer);
    // length in bits (big-endian, 64-bit). Length fits in 32 bits for our use.
    dv.setUint32(padded.length - 4, len * 8, false);

    const H = new Uint32Array([
      0x6a09e667,0xbb67ae85,0x3c6ef372,0xa54ff53a,
      0x510e527f,0x9b05688c,0x1f83d9ab,0x5be0cd19,
    ]);
    const W = new Uint32Array(64);
    for (let off = 0; off < padded.length; off += 64) {
      for (let t = 0; t < 16; t++) W[t] = dv.getUint32(off + t * 4, false);
      for (let t = 16; t < 64; t++) {
        const s0 = rotr(W[t-15], 7) ^ rotr(W[t-15], 18) ^ (W[t-15] >>> 3);
        const s1 = rotr(W[t-2], 17) ^ rotr(W[t-2], 19) ^ (W[t-2] >>> 10);
        W[t] = (W[t-16] + s0 + W[t-7] + s1) >>> 0;
      }
      let a=H[0],b=H[1],c=H[2],d=H[3],e=H[4],f=H[5],g=H[6],h=H[7];
      for (let t = 0; t < 64; t++) {
        const S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
        const ch = (e & f) ^ ((~e) & g);
        const T1 = (h + S1 + ch + K[t] + W[t]) >>> 0;
        const S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
        const maj = (a & b) ^ (a & c) ^ (b & c);
        const T2 = (S0 + maj) >>> 0;
        h = g; g = f; f = e; e = (d + T1) >>> 0;
        d = c; c = b; b = a; a = (T1 + T2) >>> 0;
      }
      H[0] = (H[0] + a) >>> 0; H[1] = (H[1] + b) >>> 0;
      H[2] = (H[2] + c) >>> 0; H[3] = (H[3] + d) >>> 0;
      H[4] = (H[4] + e) >>> 0; H[5] = (H[5] + f) >>> 0;
      H[6] = (H[6] + g) >>> 0; H[7] = (H[7] + h) >>> 0;
    }
    const out = new Uint8Array(32);
    const outDv = new DataView(out.buffer);
    for (let i = 0; i < 8; i++) outDv.setUint32(i * 4, H[i], false);
    return out.buffer;
  }

  function toBytes(data) {
    if (data instanceof ArrayBuffer) return new Uint8Array(data);
    if (ArrayBuffer.isView(data)) return new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
    throw new TypeError('Polyfill digest: expected BufferSource');
  }

  const subtle = (window.crypto && window.crypto.subtle) || {};
  const realDigest = subtle.digest && subtle.digest.bind(subtle);
  const polyfillDigest = (algorithm, data) => {
    const name = typeof algorithm === 'string' ? algorithm : (algorithm && algorithm.name);
    if (name === 'SHA-256') {
      try { return Promise.resolve(sha256(toBytes(data))); }
      catch (e) { return Promise.reject(e); }
    }
    if (realDigest) return realDigest(algorithm, data);
    return Promise.reject(new Error('Polyfill: unsupported algorithm ' + name));
  };

  try {
    if (!window.crypto) window.crypto = {};
    if (!window.crypto.subtle) {
      Object.defineProperty(window.crypto, 'subtle', {
        configurable: true, value: { digest: polyfillDigest },
      });
    } else if (!window.crypto.subtle.digest) {
      window.crypto.subtle.digest = polyfillDigest;
    }
  } catch (e) { /* best effort */ }
})();
"""


def _needs_insecure_origin_polyfill() -> bool:
    """True when the worker is hitting at least one Docker-internal HTTP
    origin. In single-worker mode the override is unset and the host's
    ``http://localhost:<port>`` URLs are already secure contexts — no
    polyfill needed."""
    if not _BASE_URL_OVERRIDE:
        return False
    try:
        for url in json.loads(_BASE_URL_OVERRIDE).values():
            if isinstance(url, str) and url.startswith("http://"):
                return True
    except (json.JSONDecodeError, TypeError, AttributeError):
        return False
    return False


def _apply_insecure_origin_polyfill(context: BrowserContext) -> None:
    """Inject the secure-context / crypto.subtle polyfill into every page
    of ``context`` (parallel mode only — no-op otherwise)."""
    if _needs_insecure_origin_polyfill():
        context.add_init_script(_INSECURE_ORIGIN_POLYFILL)


