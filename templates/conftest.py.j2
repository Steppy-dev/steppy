def _get_storage_state(role: str) -> str | None:
    """Return path to cached auth state if valid, else None."""
    state_path = AUTH_DIR / f"{role}.json"
    if not state_path.exists():
        return None
    ttl = CONFIG.get("auth", {}).get("storage_state_ttl", 3600)
    if time.time() - state_path.stat().st_mtime > ttl:
        return None
    return str(state_path)


