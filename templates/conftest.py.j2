def _new_role_context(browser: Browser, role: str, **extra) -> BrowserContext:
    """Create a browser context configured for ``role``.

    Single definition of what a Steppy context IS: the layout's viewport and
    capture density, the app's base URL, the browser locale/timezone, video
    recording when enabled, and the insecure-origin polyfill.

    Every auth mode builds its context here. Previously each of the six call
    sites spelled the kwargs out, so every browser-capability feature
    (device_scale_factor, video, locale/timezone, the polyfill) had to be
    threaded through all six — and missing one silently degraded a single auth
    mode with no test failure.

    ``extra`` carries per-mode kwargs, e.g. ``storage_state=``.
    """
    app = CONFIG["apps"][role]
    context = browser.new_context(
        viewport=_get_viewport_for_layout(CURRENT_LAYOUT),
        device_scale_factor=_get_scale_factor_for_layout(CURRENT_LAYOUT),
        base_url=app["url"],
        locale=_resolve_browser_locale(role),
        timezone_id=_resolve_browser_timezone(role),
        **_video_context_kwargs(),
        **extra,
    )
    _apply_insecure_origin_polyfill(context)
    return context


def _authenticate_auth0(browser: Browser, role: str) -> BrowserContext:
    """Perform Auth0 login and cache the storage state."""
    app = CONFIG["apps"][role]
    form = _form_selectors()

    context = _new_role_context(browser, role)
    page = context.new_page()
    # goto() waits for `load` unless told otherwise; honour a weaker strategy
    # the way the navigate action does.
    wait_until = {"domcontentloaded": "domcontentloaded", "none": "commit"}.get(_navigate_wait())
    page.goto(form.get("login_path") or "/", **({"wait_until": wait_until} if wait_until else {}))

    fill_login_credentials(page, role)

    # Wait for redirect back to app. A provider served on the app's own origin
    # already matches `<url>/**`; post_login_url_pattern is the precise answer.
    page.wait_for_url(form.get("post_login_url_pattern") or f"{app['url']}/**", timeout=15000)
    _login_settle(page, timeout=30000)

    # Cache state
    AUTH_DIR.mkdir(parents=True, exist_ok=True)
    context.storage_state(path=str(AUTH_DIR / f"{role}.json"))
    page.close()
    return context


def get_authenticated_context(browser: Browser, role: str) -> BrowserContext:
    """Get an authenticated browser context for the given role."""
    app = CONFIG["apps"][role]
    mode = app["auth"]["mode"]

    if mode in ("form", "auth0"):
        state = _get_storage_state(role)
        if state:
            return _new_role_context(browser, role, storage_state=state)
        return _authenticate_auth0(browser, role)

    elif mode == "storage-state":
        return _new_role_context(browser, role, storage_state=app["auth"]["storage_state_path"])

    elif mode == "bypass":
        context = _new_role_context(browser, role)
        bypass = app["auth"].get("bypass", {})
        if bypass.get("cookie"):
            context.add_cookies([bypass["cookie"]])
        return context

    elif mode == "token":
        return _authenticate_token(browser, role)

    else:
        raise ValueError(f"Unknown auth mode: {mode}")


def _authenticate_token(browser: Browser, role: str) -> BrowserContext:
    """Fetch a token from the configured endpoint and inject it (FLAWS §6.2).

    Mirrors ``steppy.auth.authenticate_token`` but uses the stdlib
    (``urllib``/``json``) so generated projects need no extra runtime deps.
    ``inject_as``: ``localStorage`` | ``cookie`` | ``header``.
    """
    import urllib.request
    from urllib.parse import urlparse

    app = CONFIG["apps"][role]
    token_cfg = app["auth"].get("token")
    if not token_cfg:
        raise ValueError(f"Token auth for role '{role}' requires apps.{role}.auth.token")

    body = token_cfg.get("body")
    data = json.dumps(body).encode("utf-8") if body is not None else None
    req = urllib.request.Request(
        token_cfg["endpoint"],
        data=data,
        method=token_cfg.get("method", "POST"),
        headers={"Content-Type": "application/json"} if data is not None else {},
    )
    with urllib.request.urlopen(req, timeout=10) as resp:
        payload = json.loads(resp.read().decode("utf-8"))
    token = payload.get("token") or payload.get("access_token") or payload
    if not isinstance(token, str):
        raise ValueError(f"Token endpoint returned invalid data for role '{role}'")

    inject_as = token_cfg["inject_as"]
    key = token_cfg["key"]

    context = _new_role_context(browser, role)

    if inject_as == "header":
        # Default request header on the context; `key` is the header name.
        context.set_extra_http_headers({key: token})
    elif inject_as == "cookie":
        domain = urlparse(app["url"]).hostname
        if not domain:
            raise ValueError(f"Cannot derive a cookie domain from apps.{role}.url")
        context.add_cookies([{"name": key, "value": token, "domain": domain, "path": "/"}])
    elif inject_as == "localStorage":
        page = context.new_page()
        page.goto(app["url"])
        # Pass key/token as arguments (not interpolated) — the token is
        # network-sourced and could contain a quote (mirrors FLAWS §3.3).
        page.evaluate("([k, v]) => localStorage.setItem(k, v)", [key, token])
        page.close()
    else:
        raise ValueError(f"Unknown token inject_as: {inject_as}")

    return context


# ── Locale init script ──────────────────────────────────────────────────────

# Warned-about (role, locale) pairs, so a 40-scenario run reports each gap once
# rather than once per test.
_LOCALE_NOT_SWITCHABLE: set = set()


def _base_language(tag: str) -> str:
    """Bare language subtag of ``tag``, lowercased (``fr-BE`` -> ``fr``).

    **Byte-mirrored** from ``base_language`` in ``src/steppy/locales.py`` --
    generated tests are standalone and cannot import steppy, so the body lives
    in both places. Guard: ``tests/test_conftest_locale_mirror.py``. Apply any
    change to both.
    """
    return tag.replace("_", "-").split("-", 1)[0].lower()


def _warn_locale_not_switchable(role: str, locale: str, declared) -> None:
    """Report that the app was NOT switched into ``locale``.

    Skipping silently is the worst option available here, and it is what this
    used to do: the run still captures a full set of screenshots and still files
    them under the locale's directory, so ``steppy build`` publishes one
    language's screenshots on another language's page and nothing at any stage
    reports a problem. A warning lands in pytest's summary without ``-s``.
    """
    marker = (role, locale)
    if marker in _LOCALE_NOT_SWITCHABLE:
        return
    _LOCALE_NOT_SWITCHABLE.add(marker)
    warnings.warn(
        f"apps.{role}.i18n.localstorage.values has no entry for locale {locale!r} "
        f"(declared: {', '.join(declared) or 'none'}), so the app was not switched "
        f"into it. Screenshots for this locale will show the app's default language "
        f"while being filed under {locale!r}/. Add the entry to config.yaml.",
        stacklevel=2,
    )


def _apply_locale_init_script(context: BrowserContext, role: str, locale) -> None:
    """If the app declares ``i18n.localstorage`` and a locale is active, inject
    a ``localStorage.setItem`` init script so the value is in place before any
    page script runs. No-op when locale is None or the app has no i18n block.

    A regional locale falls back to its bare language (``fr-BE`` -> ``fr``), the
    same rung ``GuideText.get`` and ``pick_locale`` use, so a project can add
    ``fr-BE`` without rewriting its i18n map. When neither key exists the run
    warns rather than skipping quietly -- see ``_warn_locale_not_switchable``.
    """
    if not locale:
        return
    app = CONFIG.get("apps", {}).get(role, {})
    i18n = app.get("i18n") or {}
    ls = i18n.get("localstorage") or {}
    key = ls.get("key")
    values = ls.get("values") or {}
    if not key:
        return
    if locale in values:
        value = values[locale]
    else:
        bare = _base_language(locale)
        if bare in values:
            value = values[bare]
        else:
            _warn_locale_not_switchable(role, locale, sorted(values))
            return
    script = (
        "try { window.localStorage.setItem("
        + json.dumps(key) + ", " + json.dumps(value)
        + "); } catch (e) {}"
    )
    context.add_init_script(script)


