def _sanitise_nodeid(nodeid: str) -> str:
    """Make a pytest nodeid filesystem-safe for use as a screenshot filename."""
    return (
        nodeid
        .replace("/", "_")
        .replace("\\", "_")
        .replace("::", "__")
        .replace("[", "(")
        .replace("]", ")")
    )


def _attach_page_diagnostics(page: Page) -> None:
    """Attach passive listeners to capture console messages, JS errors, and
    failed network requests for later inspection by the failure hook.

    Critical for headless parallel-mode runs where the browser is inside a
    worker container — without these, a ``Page.click: Timeout … waiting for
    locator(.login-cta)`` failure gives you no hint that the SPA never
    bootstrapped because, e.g., a script tag 404'd or the Auth0 SDK threw
    on a misconfigured redirect URI.

    The listeners append to lists stored on the page object; the failure
    hook reads them via ``getattr``. Setting attributes on a Playwright
    Page is fine — it's a regular Python object with no __slots__.
    """
    page._steppy_console: list[str] = []  # type: ignore[attr-defined]
    page._steppy_errors: list[str] = []  # type: ignore[attr-defined]
    page._steppy_failed_requests: list[str] = []  # type: ignore[attr-defined]

    def _on_console(msg):
        try:
            page._steppy_console.append(f"[{msg.type}] {msg.text}")  # type: ignore[attr-defined]
        except Exception:
            pass

    def _on_pageerror(exc):
        try:
            page._steppy_errors.append(str(exc))  # type: ignore[attr-defined]
        except Exception:
            pass

    def _on_requestfailed(req):
        try:
            page._steppy_failed_requests.append(  # type: ignore[attr-defined]
                f"{req.method} {req.url}  →  {req.failure}"
            )
        except Exception:
            pass

    page.on("console", _on_console)
    page.on("pageerror", _on_pageerror)
    page.on("requestfailed", _on_requestfailed)


def _dump_page_diagnostics(page: Page, prefix: str = "  ") -> None:
    """Print the diagnostics captured by ``_attach_page_diagnostics`` for one
    page. Truncates each section so a chatty SPA doesn't drown the test log."""
    console = getattr(page, "_steppy_console", None)
    errors = getattr(page, "_steppy_errors", None)
    failed = getattr(page, "_steppy_failed_requests", None)
    if errors:
        print(f"{prefix}JS errors ({len(errors)}):", flush=True)
        for line in errors[-10:]:
            print(f"{prefix}  {line}", flush=True)
    if failed:
        print(f"{prefix}Failed requests ({len(failed)}):", flush=True)
        for line in failed[-10:]:
            print(f"{prefix}  {line}", flush=True)
    if console:
        recent_problems = [m for m in console if m.startswith(("[error]", "[warning]"))]
        sample = recent_problems[-10:] if recent_problems else console[-5:]
        print(f"{prefix}Console (showing {len(sample)} of {len(console)}):", flush=True)
        for line in sample:
            print(f"{prefix}  {line}", flush=True)


# ── Coverage recorder (STEPPY_COVERAGE=1) ───────────────────────────────────
# Captures three web-standard signals per page fixture — route trail, network
# requests, V8 JS coverage — and writes one raw record JSON per fixture
# instance to ``<records_dir>/raw/<run_id>/<scenario>/``. Raw and lossless on
# purpose: all interpretation (route normalization, API classification,
# source-map decoding) happens steppy-side at merge (`steppy coverage`), so
# rules can evolve without recapturing. Framework-agnostic: URL, History API,
# CDP Profiler, and request events only.

_COVERAGE_HISTORY_HOOK = """
(() => {
  if (window.__steppyRouteHook) return;
  window.__steppyRouteHook = true;
  var emit = function (kind) {
    try { window.__steppy_route_event({ u: String(location.href), k: kind, t: Date.now() }); }
    catch (e) {}
  };
  var wrap = function (fn, kind) {
    return function () { var r = fn.apply(this, arguments); emit(kind); return r; };
  };
  try { history.pushState = wrap(history.pushState, "push"); } catch (e) {}
  try { history.replaceState = wrap(history.replaceState, "replace"); } catch (e) {}
  window.addEventListener("popstate", function () { emit("pop"); });
  window.addEventListener("hashchange", function () { emit("hash"); });
  emit("init");
})();
"""

_COVERAGE_MAX_REQUESTS = 2000


def _coverage_start(context: BrowserContext, page: Page, role: str, noauth: bool):
    """Begin coverage recording for one page fixture.

    Returns the recorder state dict, or ``None`` when ``STEPPY_COVERAGE`` is
    off (``_coverage_stop_and_write`` no-ops on ``None``).

    Route trail is layered: ``framenavigated`` is authoritative (Playwright
    counts History-API URL changes as navigations), while the injected
    history hook enriches the trail with push/replace/pop/hash kinds and
    backstops Playwright behaviour changes. Handlers only append to plain
    lists — no Playwright calls inside event handlers (sync-API reentry is
    forbidden), same pattern as ``_attach_page_diagnostics``. JS coverage
    uses a CDP ``Profiler`` session (Chromium only; playwright-python has no
    ``page.coverage`` API) and degrades to ``js_coverage.ok = false``.
    """
    if not COVERAGE_ENABLED:
        return None
    state = {
        "page": page,
        "context": context,
        "role": role,
        "noauth": noauth,
        "locale": CURRENT_LOCALE,
        "layout": CURRENT_LAYOUT,
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "nav_events": [],
        "spa_events": [],
        "requests": [],
        "requests_dropped": 0,
        "cdp": None,
        "js_error": None,
    }

    def _on_framenavigated(frame):
        try:
            if frame.parent_frame is None:
                state["nav_events"].append(
                    {"u": frame.url, "k": "nav", "t": time.time() * 1000}
                )
        except Exception:
            pass

    def _on_request(request):
        try:
            if len(state["requests"]) >= _COVERAGE_MAX_REQUESTS:
                state["requests_dropped"] += 1
                return
            state["requests"].append(
                {"m": request.method, "u": request.url, "rt": request.resource_type}
            )
        except Exception:
            pass

    page.on("framenavigated", _on_framenavigated)
    context.on("request", _on_request)
    try:
        context.expose_binding(
            "__steppy_route_event",
            lambda source, payload: state["spa_events"].append(payload),
        )
        context.add_init_script(_COVERAGE_HISTORY_HOOK)
    except Exception:
        pass  # SPA kind-tagging is enrichment; framenavigated stays authoritative
    try:
        cdp = context.new_cdp_session(page)
        cdp.send("Profiler.enable")
        # Debugger.enable pins script sources so getScriptSource still works
        # at teardown; function-granularity coverage is enough for module
        # mapping and far cheaper than block coverage.
        cdp.send("Debugger.enable")
        cdp.send("Profiler.startPreciseCoverage", {"callCount": False, "detailed": False})
        state["cdp"] = cdp
    except Exception as exc:
        state["js_error"] = str(exc)
    return state


def _coverage_map_info(source: str, script_url: str) -> dict:
    """Extract the script's sourceMappingURL reference.

    Inline ``data:`` maps are decoded and persisted NOW (gzipped,
    content-hash-deduplicated under ``raw/<run_id>/_maps/``) because they
    only exist at record time. External map URLs are stored as plain strings;
    the merge step resolves them on local disk via ``coverage.sourcemap_dir``.
    """
    marker = "sourceMappingURL="
    ref = ""
    for chunk in (source[-1024:], source):  # tail first — the comment is conventionally last
        pos = chunk.rfind(marker)
        if pos != -1:
            tokens = chunk[pos + len(marker):].split()
            ref = tokens[0].rstrip("*/").strip() if tokens else ""
            break
    if not ref:
        return {"kind": "none", "reason": "no sourceMappingURL"}
    if ref.startswith("data:"):
        try:
            import base64
            import gzip
            import hashlib

            raw = base64.b64decode(ref.split(",", 1)[1])
            digest = hashlib.sha256(raw).hexdigest()
            maps_dir = COVERAGE_RAW_DIR / COVERAGE_RUN_ID / "_maps"
            maps_dir.mkdir(parents=True, exist_ok=True)
            blob = maps_dir / (digest + ".json.gz")
            if not blob.exists():
                blob.write_bytes(gzip.compress(raw))
            return {"kind": "inline", "hash": digest}
        except Exception as exc:
            return {"kind": "none", "reason": "inline map decode failed: " + str(exc)}
    return {"kind": "external", "url": ref}


def _coverage_collect_js(state) -> dict:
    """Stop CDP profiling and shape the per-script coverage payload.

    Per executed script (http(s) URLs only): the executed function start
    offsets, a ``line_starts`` newline-offset table computed from the script
    source (the source itself is discarded — never persisted), and the source
    map reference. Every CDP step is individually guarded; any failure
    degrades to ``ok: false`` instead of losing the rest of the record.
    """
    cdp = state.get("cdp")
    if cdp is None:
        return {
            "ok": False,
            "reason": state.get("js_error") or "cdp unavailable",
            "scripts": [],
        }
    scripts = []
    try:
        result = cdp.send("Profiler.takePreciseCoverage").get("result", [])
        for entry in result:
            url = entry.get("url") or ""
            if not url.startswith(("http://", "https://")):
                continue  # anonymous evals, init scripts, extensions
            offsets = sorted(
                {
                    f["ranges"][0]["startOffset"]
                    for f in entry.get("functions", [])
                    if f.get("ranges") and f["ranges"][0].get("count", 0) > 0
                }
            )
            if not offsets:
                continue
            source = None
            try:
                source = cdp.send(
                    "Debugger.getScriptSource", {"scriptId": entry["scriptId"]}
                ).get("scriptSource")
            except Exception:
                source = None
            if source is None:
                try:
                    resp = state["page"].request.get(url, timeout=10000)
                    source = resp.text() if resp.ok else None
                except Exception:
                    source = None
            line_starts = None
            map_info = {"kind": "none", "reason": "script source unavailable"}
            if source is not None:
                line_starts = [0]
                idx = source.find("\n")
                while idx != -1:
                    line_starts.append(idx + 1)
                    idx = source.find("\n", idx + 1)
                map_info = _coverage_map_info(source, url)
            scripts.append(
                {
                    "url": url,
                    "executed_offsets": offsets,
                    "line_starts": line_starts,
                    "map": map_info,
                }
            )
    except Exception as exc:
        return {"ok": False, "reason": str(exc), "scripts": []}
    finally:
        for command in ("Profiler.stopPreciseCoverage", "Profiler.disable", "Debugger.disable"):
            try:
                cdp.send(command)
            except Exception:
                pass
        try:
            cdp.detach()
        except Exception:
            pass
    scripts.sort(key=lambda s: s["url"])
    return {"ok": True, "reason": None, "scripts": scripts}


def _coverage_stop_and_write(state, request) -> None:
    """Finish recording and write the raw record JSON. Never raises — a
    recorder bug must not fail the test run. Must be called BEFORE
    ``page.close()`` (the JS-coverage flush needs the live page/context)."""
    if state is None:
        return
    try:
        scenario = getattr(request.module, "SCENARIO", None) or _sanitise_nodeid(
            request.node.name
        )
        failed = getattr(request.node, "_steppy_call_failed", None)
        outcome = "unknown" if failed is None else ("failed" if failed else "passed")
        record = {
            "steppy_coverage_record": 1,
            "run_id": COVERAGE_RUN_ID,
            "scenario": scenario,
            "role": state["role"],
            "noauth": state["noauth"],
            "locale": state["locale"],
            "layout": state["layout"],
            "asserts_enabled": not SKIP_ASSERTS,
            "guide_mode": GUIDE_MODE,
            "outcome": outcome,
            "started_at": state["started_at"],
            "finished_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
            "nav_events": state["nav_events"],
            "spa_events": [e for e in state["spa_events"] if isinstance(e, dict)],
            "requests": state["requests"],
            "requests_dropped": state["requests_dropped"],
            "js_coverage": _coverage_collect_js(state),
        }
        folder = COVERAGE_RAW_DIR / COVERAGE_RUN_ID / scenario
        folder.mkdir(parents=True, exist_ok=True)
        suffix = f"{state['locale'] or 'default'}-{state['layout'] or 'default'}"
        name = f"{state['role']}_page{'_noauth' if state['noauth'] else ''}__{suffix}.json"
        (folder / name).write_text(json.dumps(record, indent=2), encoding="utf-8")
    except Exception as exc:
        print(f"[steppy] coverage record failed: {exc}", flush=True)


@pytest.hookimpl(hookwrapper=True)
def pytest_runtest_makereport(item, call):
    """Capture a screenshot, URL, title, JS errors, and failed requests from
    every active ``*_page`` fixture when a test fails. Lands under
    ``output/screenshots/_failures/`` with details printed inline so the user
    can diagnose without re-running with extra flags.

    Best-effort: any exception during capture is swallowed so a debug aid
    never compounds a real test failure.

    Also stamps the call-phase outcome onto the item: makereport(call) fires
    before fixture finalizers, so the coverage recorder's teardown can record
    whether the scenario passed.
    """
    outcome = yield
    rep = outcome.get_result()
    if rep.when == "call":
        item._steppy_call_failed = rep.failed
    if rep.when != "call" or not rep.failed:
        return
    failure_dir = SCREENSHOTS_DIR / "_failures"
    try:
        failure_dir.mkdir(parents=True, exist_ok=True)
    except OSError:
        return
    safe_id = _sanitise_nodeid(item.nodeid)
    for fixture_name, value in item.funcargs.items():
        if not (fixture_name.endswith("_page") or fixture_name.endswith("_page_noauth")):
            continue
        if not hasattr(value, "screenshot"):
            continue
        path = failure_dir / f"{safe_id}__{fixture_name}.png"
        try:
            value.screenshot(path=str(path), full_page=True, timeout=5000)
        except Exception:
            path = None
        try:
            url = value.url
        except Exception:
            url = "<unknown>"
        try:
            title = value.title()
        except Exception:
            title = "<unknown>"
        print(
            f"\n[steppy] {fixture_name} failure  url={url}  title={title!r}",
            flush=True,
        )
        if path is not None:
            print(f"  screenshot: {path}", flush=True)
        _dump_page_diagnostics(value, prefix="  ")


# ── Capture / interpolation helpers ─────────────────────────────────────────

{% raw %}
def _interp(s, _vars):
    """Substitute {{var}} placeholders in `s` from `_vars`. No-op if no braces."""
    if not s or "{{" not in s:
        return s
    out = s
    for k, v in _vars.items():
        out = out.replace("{{" + k + "}}", str(v))
    return out


def _interp_shell(s, _vars):
    """Like _interp, but shell-quote each substituted value.

    Used only for `capture from.type=shell` commands, where a {{var}} may hold
    DOM-scraped or HTTP-sourced content. Quoting the *values* (not the author's
    static command template) neutralizes shell metacharacters so page content
    can't inject into the subprocess.
    """
    import shlex
    if not s or "{{" not in s:
        return s
    out = s
    for k, v in _vars.items():
        out = out.replace("{{" + k + "}}", shlex.quote(str(v)))
    return out
{% endraw %}


def _interp_val(s, _vars):
    """Like ``_interp`` but ALSO resolves ${VAR} / ${VAR:-default} from the
    environment.

    Used only at fill/select VALUE sites so secret placeholders emitted by
    ``steppy record`` (e.g. ${STEPPY_ADMIN_TOKEN}) resolve at run time from the
    worker/CI environment. Selector and target sites keep plain ``_interp`` — their
    semantics are unchanged. An unset var with no default is left as the literal
    ${...} (same silent policy as ``_interp_env``). Defined after the endraw
    marker above so it stays out of the ``_interp`` unit-test extract.
    """
    if isinstance(s, str) and "${" in s:
        def _sub(m):
            name, default = m.group(1), m.group(2)
            if name in os.environ:
                return os.environ[name]
            if default is not None:
                return default
            return m.group(0)
        s = _ENV_REF.sub(_sub, s)
    return _interp(s, _vars)


def _resolve_date_obj(expr):
    """Resolve a relative/dynamic date expression to a ``datetime.date`` AT RUN
    TIME (so generated tests stay valid forever). Shared by ``fill-date`` (which
    formats the result) and ``pick-date`` (which needs the date object to compute
    month deltas and the target day).

    Grammar:
      today               -> current date
      this-<weekday>      -> that weekday in the current (Monday-anchored) week
      next-<weekday>      -> the next strictly-future occurrence of that weekday
      ±N[d|w|m|y]         -> offset by N days / weeks / months / years (e.g. +7d, -1m)
      YYYY-MM-DD          -> ISO literal
    """
    import calendar
    import datetime
    import re as _re

    expr = (expr or "").strip().lower()
    today = datetime.date.today()
    weekdays = {
        "monday": 0, "tuesday": 1, "wednesday": 2, "thursday": 3,
        "friday": 4, "saturday": 5, "sunday": 6,
    }
    if expr == "today":
        d = today
    elif expr.startswith("this-") and expr[5:] in weekdays:
        d = today - datetime.timedelta(days=today.weekday() - weekdays[expr[5:]])
    elif expr.startswith("next-") and expr[5:] in weekdays:
        delta = (weekdays[expr[5:]] - today.weekday()) % 7 or 7
        d = today + datetime.timedelta(days=delta)
    elif _re.match(r"^[+-]\d+[dwmy]$", expr):
        sign = 1 if expr[0] == "+" else -1
        n = sign * int(expr[1:-1])
        unit = expr[-1]
        if unit == "d":
            d = today + datetime.timedelta(days=n)
        elif unit == "w":
            d = today + datetime.timedelta(weeks=n)
        elif unit == "m":
            month_index = today.year * 12 + (today.month - 1) + n
            year, month0 = divmod(month_index, 12)
            month = month0 + 1
            day = min(today.day, calendar.monthrange(year, month)[1])
            d = datetime.date(year, month, day)
        else:  # 'y'
            year = today.year + n
            day = min(today.day, calendar.monthrange(year, today.month)[1])
            d = datetime.date(year, today.month, day)
    else:
        d = datetime.date.fromisoformat(expr)
    return d


def _resolve_date(expr, fmt="%d/%m/%Y"):
    """Resolve a date expression (see ``_resolve_date_obj``) and format it with
    ``fmt``. Driven by the ``fill-date`` action."""
    return _resolve_date_obj(expr).strftime(fmt)


def _open_datepicker(page, selector, panel, trigger, timeout):
    """Open a PrimeNG (date|time)picker panel from its host: prefer a showIcon
    ``trigger`` button, else the inner <input>, else the host; wait for ``panel``."""
    host = page.locator(selector)
    opener = None
    if trigger:
        trig = host.locator(trigger)
        if trig.count():
            opener = trig.first
    if opener is None:
        inp = host.locator("input")
        opener = inp.first if inp.count() else host
    opener.click()
    page.wait_for_selector(panel, state="visible", timeout=timeout)


def _pick_date(page, selector, expr, *, panel, next_btn, prev_btn, day_cell, trigger="", timeout=30000):
    """Drive a calendar widget (PrimeNG ``p-datepicker`` by default) to a target
    date computed at run time. Opens the panel from ``selector``, steps forward
    or backward to the target month, clicks the day cell, and waits for the panel
    to close. Selectors are config-driven so non-PrimeNG kits can retarget."""
    import datetime
    import re as _re

    target = _resolve_date_obj(expr)
    today = datetime.date.today()
    months = (target.year - today.year) * 12 + (target.month - today.month)
    _open_datepicker(page, selector, panel, trigger, timeout)
    step_btn = next_btn if months >= 0 else prev_btn
    for _ in range(abs(months)):
        page.locator(step_btn).first.click()
        page.wait_for_timeout(120)
    # Exact day match so "1" doesn't match "10"/"11"/… (substring filter would).
    page.locator(day_cell).filter(
        has_text=_re.compile(rf"^\s*{target.day}\s*$")
    ).first.click()
    page.wait_for_selector(panel, state="hidden", timeout=timeout)


def _pick_time(page, selector, value, *, panel, hour_picker, minute_picker, trigger="", timeout=30000):
    """Drive a PrimeNG ``timeOnly`` picker to a target ``HH:MM``. Opens the panel
    (showIcon trigger -> inner <input> -> host), spins each column's up/down arrow
    until its value <span> reads the target, then presses Escape to close so the
    overlay can't intercept later clicks. Column-scoped (``{col} button`` first/
    last + ``{col} > span``) so it works regardless of whether PrimeNG tags the
    arrows with increment/decrement classes. Assumes ``stepHour``/``stepMinute``
    == 1 (PrimeNG default). Selectors are config-driven for non-PrimeNG kits."""
    target_h, target_m = (int(p) for p in value.strip().split(":"))
    _open_datepicker(page, selector, panel, trigger, timeout)
    _panel = page.locator(panel).last

    def _spin(col_sel, target_val, modulo):
        # Bounded by ``modulo`` so a stuck widget can't loop forever.
        buttons = _panel.locator(col_sel + " button")        # first=up, last=down
        value_span = _panel.locator(col_sel + " > span")     # direct-child value
        for _ in range(modulo):
            current = int((value_span.first.inner_text() or "0").strip())
            if current == target_val:
                return
            diff = (target_val - current) % modulo
            # Step the short way around the dial.
            (buttons.first if diff <= modulo // 2 else buttons.last).click()
            page.wait_for_timeout(80)

    _spin(hour_picker, target_h, 24)
    _spin(minute_picker, target_m, 60)
    page.keyboard.press("Escape")
    page.wait_for_selector(panel, state="hidden", timeout=timeout)


_SYNTHETIC_CLICK_JS = """
el => {
  el.scrollIntoView({block: 'center'});
  const target = el.querySelector('button, input, [role="button"]') || el;
  const r = target.getBoundingClientRect();
  const opts = {bubbles: true, cancelable: true, view: window, button: 0,
                clientX: r.left + r.width / 2, clientY: r.top + r.height / 2};
  target.dispatchEvent(new MouseEvent('mousedown', opts));
  target.dispatchEvent(new MouseEvent('mouseup', opts));
  target.dispatchEvent(new MouseEvent('click', opts));
}
"""


_WAIT_COMPARATOR = re.compile(r"^(>=|<=|==|!=|>|<)\s*(\d+)$")


def _wait_until(locator, spec: str, timeout: int, interval: int = 100, message: str = "") -> None:
    """Block until a *state* predicate holds on ``locator``, not just presence.

    Playwright's own ``wait_for`` accepts only visible/hidden/detached/attached,
    which cannot say "the form has finished pre-filling" — so scenarios polled
    it by hand. The dominant shape in the corpus, 47 times over, was:

        deadline = time.time() + 10
        while time.time() < deadline:
            if page.input_value(sel):
                break
            page.wait_for_timeout(100)

    Polled from Python rather than through ``wait_for_function`` on purpose: the
    predicate has to observe the element through *Playwright's* locator, which
    understands ``text=``/``>>`` and the other selector engines that
    ``document.querySelector`` does not.

    spec:
      value-not-empty     -- the input has a value
      value:<text>        -- the input's value equals <text>
      text:<text>         -- the element's text contains <text>
      count:<cmp><n>      -- how many elements match, e.g. count:>=2

    ``message`` replaces the wait-for wording when the predicate never holds;
    a ``count(sel, >=N)`` assertion polls through here and passes its own.
    """
    deadline = time.monotonic() + timeout / 1000.0
    last = None
    while True:
        try:
            if spec == "value-not-empty":
                last = locator.first.input_value(timeout=timeout)
                if last:
                    return
            elif spec.startswith("value:"):
                want = spec[6:]
                last = locator.first.input_value(timeout=timeout)
                if last == want:
                    return
            elif spec.startswith("text:"):
                want = spec[5:]
                last = locator.first.inner_text(timeout=timeout)
                if want in last:
                    return
            elif spec.startswith("count:"):
                match = _WAIT_COMPARATOR.match(spec[6:])
                comparator, expected = match.group(1), int(match.group(2))
                last = locator.count()
                if {
                    ">=": last >= expected,
                    "<=": last <= expected,
                    "==": last == expected,
                    "!=": last != expected,
                    ">": last > expected,
                    "<": last < expected,
                }[comparator]:
                    return
            else:  # pragma: no cover - validation rejects this at parse time
                raise AssertionError(f"_wait_until: unknown predicate {spec!r}")
        except AssertionError:
            raise
        except Exception as exc:  # the element may not exist yet
            last = f"<{type(exc).__name__}>"
        if time.monotonic() >= deadline:
            if message:
                raise AssertionError(f"{message} (last saw {last!r} after {timeout}ms)")
            raise AssertionError(f"wait-for until={spec!r} not satisfied within {timeout}ms (last saw {last!r})")
        time.sleep(interval / 1000.0)


def _assert_stays_hidden(locator, ms: int, message: str = "", interval: int = 250) -> None:
    """Assert an element stays absent for ``ms``, rather than becoming absent.

    ``expect(...).to_be_hidden()`` auto-waits for the element to *become* hidden,
    which passes the instant it is not there yet — the opposite of what "prove
    the replacement wizard never opens" needs. The corpus spells this as a
    for-loop of one-shot counts; this is that loop, once.
    """
    deadline = time.monotonic() + ms / 1000.0
    while True:
        if locator.count() and locator.first.is_visible():
            raise AssertionError(message or f"element appeared within {ms}ms but was expected to stay hidden")
        if time.monotonic() >= deadline:
            return
        time.sleep(interval / 1000.0)


_WHEN_FORMS = ("visible(", "hidden(", "count(", "contains(")


def _when(page, spec: str, _vars: dict) -> bool:
    """Evaluate a step's ``when:`` condition against the live page.

    Deliberately NOT the assertion grammar: an assertion auto-waits, which is
    the opposite of what a condition wants. "Click it if it is there" must
    answer now, from what is rendered now — waiting 30s for an element that was
    never going to appear would make every guarded step pay the timeout.

    Supported: visible(sel) | hidden(sel) | count(sel, <cmp>N) | contains(sel, "text")
    """
    spec = (spec or "").strip()
    head, _, rest = spec.partition("(")
    inner = rest[:-1] if rest.endswith(")") else rest
    if head == "visible":
        loc = page.locator(_interp(inner.strip(), _vars))
        return bool(loc.count()) and loc.first.is_visible()
    if head == "hidden":
        loc = page.locator(_interp(inner.strip(), _vars))
        return not loc.count() or not loc.first.is_visible()
    if head == "contains":
        selector, _, text = inner.partition(",")
        loc = page.locator(_interp(selector.strip(), _vars))
        if not loc.count():
            return False
        return _interp(text.strip().strip('"').strip("'"), _vars) in loc.first.inner_text()
    if head == "count":
        selector, _, raw = inner.rpartition(",")
        loc = page.locator(_interp(selector.strip(), _vars))
        match = _WAIT_COMPARATOR.match(raw.strip())
        if not match:
            return loc.count() == int(raw.strip())
        comparator, expected = match.group(1), int(match.group(2))
        found = loc.count()
        return {
            ">=": found >= expected,
            "<=": found <= expected,
            "==": found == expected,
            "!=": found != expected,
            ">": found > expected,
            "<": found < expected,
        }[comparator]
    raise AssertionError(f"_when: unsupported condition {spec!r}")


def call_helper(page, dotted: str, args=None, kwargs=None, _vars=None, pass_page: bool = True):
    """Run a project helper function as a first-class step.

    The project root is already on ``sys.path``: pytest is launched as
    ``python -m pytest`` from it, and ``python -m`` puts the working directory
    at ``sys.path[0]``. (The worker image sets ``WORKDIR /steppy/project`` for
    the same reason.) So the three-line ``sys.path.insert`` preamble that opens
    2 334 custom blocks in the measured corpus was never necessary, and nothing
    here reproduces it.

    String arguments go through ``_interp`` so a value captured by an earlier
    step reaches the helper as ``{{var}}``; non-strings pass through untouched,
    which is what keeps ``args: [6]`` an int.
    """
    import importlib

    module_name, _, fn_name = dotted.rpartition(".")
    try:
        module = importlib.import_module(module_name)
    except ImportError as exc:
        raise AssertionError(
            f"call: cannot import {module_name!r} for {dotted!r}. "
            f"Helper modules are imported from the project root ({Path.cwd()})."
        ) from exc
    try:
        fn = getattr(module, fn_name)
    except AttributeError as exc:
        raise AssertionError(f"call: {module_name!r} has no attribute {fn_name!r}") from exc

    _vars = _vars if _vars is not None else {}
    resolved_args = [_interp(a, _vars) if isinstance(a, str) else a for a in (args or [])]
    resolved_kwargs = {k: (_interp(v, _vars) if isinstance(v, str) else v) for k, v in (kwargs or {}).items()}
    if pass_page:
        return fn(page, *resolved_args, **resolved_kwargs)
    return fn(*resolved_args, **resolved_kwargs)


def synthetic_click(locator) -> None:
    """Dispatch a manual mousedown/mouseup/click sequence on a locator's element
    (Cmd 12 — ``click synthetic: true``). For custom widgets that swallow
    Playwright's native ``.click()`` and only react to raw DOM MouseEvents."""
    locator.evaluate(_SYNTHETIC_CLICK_JS)


def capture(spec: dict, _vars: dict, retry: int = 1, interval: float = 0.2) -> str:
    """Fetch a value from an external source. Retries with `interval` seconds between attempts.

    spec.type:
      - 'redis':  requires 'key'. Reads CONFIG['redis'] for connection.
      - 'http':   requires 'url'. Optional 'json_path' (e.g. '$.code') and 'headers'.
      - 'shell':  requires 'command'. Returns stdout (trimmed).
      - 'date':   requires 'date' (today|next-monday|+7d|YYYY-MM-DD). Optional
                  'format' (strftime, default '%Y-%m-%d'; '%V'/'%G' give the ISO
                  week and year). Pure — resolved at run time, never cached.
    All string fields are run through _interp() so they can reference earlier captures.
    """
    # Gate shell capture up front (not inside the retry loop) so the reason is
    # surfaced cleanly rather than wrapped in a retry AssertionError.
    if spec.get("type") == "shell" and not CONFIG.get("security", {}).get("allow_shell_capture", False):
        raise RuntimeError(
            "capture from.type=shell is disabled. It runs a shell command with "
            "page-derived values and is a command-injection vector, so it is "
            "opt-in: set security.allow_shell_capture: true in config.yaml to "
            "enable it (see SECURITY.md)."
        )
    last_err = None
    for _ in range(max(1, retry)):
        try:
            t = spec.get("type")
            if t == "redis":
                import redis  # type: ignore
                cfg = CONFIG.get("redis", {})
                r = redis.Redis(
                    host=cfg.get("host", "localhost"),
                    port=cfg.get("port", 6379),
                    db=cfg.get("db", 0),
                    decode_responses=True,
                )
                v = r.get(_interp(spec["key"], _vars))
                if v is not None:
                    return v
            elif t == "http":
                import httpx  # type: ignore
                headers = spec.get("headers") or {}
                resp = httpx.get(_interp(spec["url"], _vars), headers=headers, timeout=5)
                resp.raise_for_status()
                if "json_path" in spec:
                    import jsonpath_ng  # type: ignore
                    matches = jsonpath_ng.parse(spec["json_path"]).find(resp.json())
                    if matches:
                        return str(matches[0].value)
                else:
                    return resp.text
            elif t == "date":
                # No I/O and nothing to retry: `_resolve_date` is pure. It is
                # here rather than in a new action because the value's *use* is
                # already what `capture` is for — binding a `{{var}}` that later
                # selectors and values interpolate.
                return _resolve_date(
                    _interp(spec["date"], _vars),
                    _interp(spec.get("format") or "%Y-%m-%d", _vars),
                )
            elif t == "shell":
                import subprocess
                out = subprocess.run(
                    _interp_shell(spec["command"], _vars),
                    shell=True,
                    capture_output=True,
                    text=True,
                    check=True,
                )
                return out.stdout.strip()
            else:
                raise ValueError(f"Unknown capture type: {t!r}")
        except Exception as e:
            last_err = e
        time.sleep(interval)
    raise AssertionError(f"capture failed after {retry} attempts: spec={spec} last_err={last_err}")


def capture_dom(page, spec: dict, _vars: dict, retry: int = 1, interval: float = 0.2) -> str:
    """Read a value out of the live DOM and store it in ``_vars`` (interpolatable
    by later steps via _interp), replacing the ``globals()[...]`` capture-and-reuse
    hack. Retries with ``interval`` seconds between attempts.

    spec (from.type == 'dom'):
      - 'selector':  required. The element to read (first match is used).
      - 'extract':   text (default) | attribute | regex.
      - 'attribute': attribute name when extract == 'attribute'.
      - 'regex':     pattern applied to the extracted string; returns group 1
                     (or group 0 if the pattern has no groups). Required when
                     extract == 'regex'; also honored as a post-filter otherwise.
    """
    import re as _re

    extract = spec.get("extract", "text")
    last_err = None
    for _ in range(max(1, retry)):
        try:
            loc = page.locator(_interp(spec["selector"], _vars)).first
            loc.wait_for(state="visible", timeout=10000)
            if extract == "attribute":
                raw = loc.get_attribute(_interp(spec["attribute"], _vars))
            else:
                raw = loc.inner_text()
            if raw is None:
                raise ValueError("capture_dom: extracted value is None")
            raw = raw.strip()
            pattern = spec.get("regex")
            if pattern:
                m = _re.search(pattern, raw)
                if not m:
                    raise ValueError(f"capture_dom: regex {pattern!r} did not match {raw!r}")
                return m.group(1) if m.groups() else m.group(0)
            return raw
        except Exception as e:
            last_err = e
        time.sleep(interval)
    raise AssertionError(f"capture_dom failed after {retry} attempts: spec={spec} last_err={last_err}")


# ── Screenshot helper ───────────────────────────────────────────────────────

def _screenshot_folder(scenario: str) -> Path:
    """Return the folder PNGs/sidecars for ``scenario`` should land in.

    When ``CURRENT_LOCALE`` is set (parametrized run), images go under a
    per-locale subdir so the build can serve a different screenshot set per
    language. Otherwise they fall back to the legacy flat layout.
    """
    folder = SCREENSHOTS_DIR / scenario
    if CURRENT_LOCALE:
        folder = folder / CURRENT_LOCALE
    if CURRENT_LAYOUT:
        folder = folder / CURRENT_LAYOUT
    folder.mkdir(parents=True, exist_ok=True)
    return folder


def _screenshot_mask_kwargs(page: Page) -> dict:
    """Build page.screenshot(mask=...) kwargs from `screenshot.mask` config.

    Returns {} when no mask selectors are configured, so output is byte-identical
    for projects that don't redact. Otherwise returns solid-box masks over every
    matched element (secrets/personal-data redaction — see SECURITY.md).
    """
    masks = CONFIG.get("screenshot", {}).get("mask", []) or []
    if not masks:
        return {}
    color = CONFIG.get("screenshot", {}).get("mask_color", "#000000")
    return {"mask": [page.locator(sel) for sel in masks], "mask_color": color}


def take_screenshot(page: Page, scenario: str, step: int, suffix: str = ""):
    """Capture a screenshot if STEPPY_SCREENSHOTS is enabled."""
    if not SCREENSHOTS_ENABLED:
        return
    folder = _screenshot_folder(scenario)
    name = f"step-{step:02d}{'-' + suffix if suffix else ''}.png"
    page.screenshot(path=str(folder / name), **_screenshot_mask_kwargs(page))


def _apply_highlight(page: Page, selector: str) -> None:
    """Outline + tint an element for a guide screenshot. Best-effort."""
    highlight_css = CONFIG.get("screenshot", {})
    color = highlight_css.get("highlight_color", "rgba(255, 0, 0, 0.3)")
    border = highlight_css.get("highlight_border", "2px solid red")
    try:
        page.eval_on_selector(
            selector,
            f"el => {% raw %}{{{% endraw %} el.style.outline = '{border}'; el.style.backgroundColor = '{color}'; {% raw %}}}{% endraw %}"
        )
    except Exception:
        pass  # Element might not exist; screenshot without highlight


def _clear_highlight(page: Page, selector: str) -> None:
    """Undo :func:`_apply_highlight`. Best-effort."""
    try:
        page.eval_on_selector(
            selector,
            "el => {% raw %}{{% endraw %} el.style.outline = ''; el.style.backgroundColor = ''; {% raw %}}{% endraw %}"
        )
    except Exception:
        pass


def highlight_and_screenshot(page: Page, selector: str, scenario: str, step: int):
    """Highlight an element and take a screenshot (for guide generation)."""
    if not SCREENSHOTS_ENABLED:
        return
    _apply_highlight(page, selector)
    take_screenshot(page, scenario, step)
    _clear_highlight(page, selector)


# Per-frame suffix for multi-frame captures (step-NN-a.png, -b, …). One
# declaration: the two frame builders below must agree on the alphabet and
# on the ceiling it puts on frame count.
FRAME_LETTERS = "abcdefghijklmnopqrstuvwxyz"


# ── Cursor sidecar helper ───────────────────────────────────────────────────

def _safe_bbox(page: Page, selector: str):
    """Return locator.bounding_box() or None on any failure."""
    try:
        return page.locator(selector).first.bounding_box(timeout=1000)
    except Exception:
        return None


def _scroll_into_view(page: Page, selector: str) -> None:
    """Best-effort scroll so *selector* is in the viewport.

    The single place the scroll policy (which locator, what timeout, swallow
    failures) is expressed — the cursor-bbox timing invariant below depends on
    it, and so do the fill-form frame helpers that anchor a viewport.
    """
    try:
        page.locator(selector).first.scroll_into_view_if_needed(timeout=1000)
    except Exception:
        pass


def _safe_bbox_scrolled(page: Page, selector: str):
    """Scroll the element into view, then return its bounding box.

    Playwright actions (click/fill/...) auto-scroll the element into view before
    firing. Capturing the bbox *before* the action therefore yields stale
    viewport coordinates when the element was off-screen (e.g. inside a scrolled
    modal). Scrolling first keeps the captured bbox aligned with the viewport
    the subsequent screenshot will see.
    """
    _scroll_into_view(page, selector)
    return _safe_bbox(page, selector)


def _safe_bbox_locator(page: Page, locator):
    """Like ``_safe_bbox_scrolled`` but for an already-resolved Playwright
    Locator (used by actions that disambiguate via ``within``/``match`` or that
    build their target locator imperatively, e.g. ``confirm``). Scroll into view,
    then return its bounding box or None on any failure."""
    try:
        locator.scroll_into_view_if_needed(timeout=1000)
    except Exception:
        pass
    try:
        return locator.bounding_box(timeout=1000)
    except Exception:
        return None


def _offset_for_full_page(page: Page):
    """Return (scrollX, scrollY) when full_page screenshots are in use, else (0, 0)."""
    if not SCREENSHOT_FULL_PAGE:
        return (0, 0)
    try:
        return (
            int(page.evaluate("() => window.scrollX || 0")),
            int(page.evaluate("() => window.scrollY || 0")),
        )
    except Exception:
        return (0, 0)


def take_screenshot_with_bbox(
    page: Page,
    scenario: str,
    step: int,
    action: str,
    selector: str | None = None,
    selectors: list | None = None,
    precaptured_bbox: dict | None = None,
    precaptured_bboxes: list | None = None,
    highlight: bool = False,
    frame: str | None = None,
):
    """Capture a screenshot and a JSON sidecar containing the target bounding box(es).

    - selector / precaptured_bbox: single-target actions (click, fill, hover, ...).
    - selectors / precaptured_bboxes: multi-target actions (fill-form).
    - precaptured_* win over live resolution so the caller can capture BEFORE the action
      mutates the DOM. If both are None and a selector is supplied we fall back to
      resolving it at screenshot time.
    - If neither selector nor list is supplied, target is None (hidden cursor in guide).
    - No-op when STEPPY_SCREENSHOTS is not enabled.
    """
    if not SCREENSHOTS_ENABLED:
        return

    folder = _screenshot_folder(scenario)
    stem = f"step-{step:02d}" + (f"-{frame}" if frame else "")
    png_path = folder / f"{stem}.png"
    json_path = folder / f"{stem}.json"

    dx, dy = _offset_for_full_page(page)

    def _apply_offset(bbox):
        if not bbox:
            return None
        return {
            "x": bbox.get("x", 0) + dx,
            "y": bbox.get("y", 0) + dy,
            "width": bbox.get("width", 0),
            "height": bbox.get("height", 0),
        }

    target_payload = None
    if selectors is not None or precaptured_bboxes is not None:
        sels = selectors or []
        bboxes = precaptured_bboxes
        if bboxes is None:
            bboxes = [_safe_bbox(page, s) for s in sels]
        fields = []
        for i, bbox in enumerate(bboxes):
            fields.append({
                "selector": sels[i] if i < len(sels) else None,
                "bbox": _apply_offset(bbox),
            })
        target_payload = {"kind": "multi", "fields": fields}
    elif selector is not None or precaptured_bbox is not None:
        bbox = precaptured_bbox if precaptured_bbox is not None else _safe_bbox(page, selector)
        target_payload = {
            "kind": "single",
            "selector": selector,
            "bbox": _apply_offset(bbox),
        }

    # Optional highlight parity with highlight_and_screenshot (applied AFTER bbox capture).
    if highlight and selector:
        _apply_highlight(page, selector)

    page.screenshot(path=str(png_path), **_screenshot_mask_kwargs(page))

    if highlight and selector:
        _clear_highlight(page, selector)

    sidecar = {
        "step": step,
        "screenshot": png_path.name,
        "action": action,
        # Record the viewport this page actually ran at, which is the space its
        # bboxes were measured in. The guide renderer scales cursor bboxes
        # against this value. `CURRENT_LAYOUT` is only the fallback (a context
        # built without a viewport reports None): it is one global shared by
        # every role page a test holds, so it describes this page only while
        # those pages are parametrized in lockstep.
        "viewport": page.viewport_size or _get_viewport_for_layout(CURRENT_LAYOUT),
        # Capture devicePixelRatio for THIS layout. The guide renderer multiplies
        # viewport * this to get the screenshot's intrinsic pixel width, which it
        # uses to cap the displayed `<img>` width so a dense (e.g. mobile DSF=3)
        # capture is never upscaled. Absent in legacy sidecars ⇒ readers default 1.
        "device_scale_factor": _get_scale_factor_for_layout(CURRENT_LAYOUT),
        "target": target_payload,
    }
    json_path.write_text(json.dumps(sidecar, indent=2), encoding="utf-8")


def take_fillform_progressive_frames(
    page: Page,
    scenario: str,
    step: int,
    fields: list,
):
    """Capture a fill-form step field-by-field with a single-target cursor per frame.

    ``fields`` is an ordered list of ``(selector, value)`` tuples. For each
    field, the function:
      1. Scrolls the field into view (so its bbox lines up with the
         screenshot's viewport).
      2. Captures the current form state with a single-target ``fill-form``
         sidecar pointing at THIS field (cursor will travel here, click,
         then type).
      3. Fills the field on the real page.

    After every field is filled, a final "settled" frame is captured with no
    cursor target — the form's fully-filled end state.

    Frames are emitted as ``step-NN-a``, ``-b``, … in field declaration order,
    plus one extra letter for the settled frame. Reuses the existing letter
    scheme so the guide builder's frame discovery loop in
    ``_frame_screenshot_path`` works unchanged.

    Capture time grows with field count (one screenshot + one fill per field),
    so authors should opt in deliberately on forms where the field-by-field
    progression adds clarity.
    """
    if not SCREENSHOTS_ENABLED:
        return
    if not fields:
        return

    # +1 for the settled frame; if we'd overflow the alphabet, bail on the
    # settled frame rather than corrupting the sequence.
    n_fields = len(fields)
    if n_fields >= len(FRAME_LETTERS):
        n_fields = len(FRAME_LETTERS) - 1

    for i in range(n_fields):
        selector, value = fields[i]
        bbox = _safe_bbox_scrolled(page, selector)
        take_screenshot_with_bbox(
            page,
            scenario,
            step,
            "fill-form",
            selector=selector,
            precaptured_bbox=bbox,
            frame=FRAME_LETTERS[i],
        )
        try:
            page.locator(selector).first.fill(value)
        except Exception:
            pass

    # Settled frame: form fully filled, no cursor target. Anchor on the last
    # field so the viewport is sensible (matches the user's final scroll
    # position in real use).
    if fields:
        _scroll_into_view(page, fields[-1][0])
    take_screenshot_with_bbox(
        page,
        scenario,
        step,
        "fill-form",
        frame=FRAME_LETTERS[n_fields],
    )


def take_fillform_frames(
    page: Page,
    scenario: str,
    step: int,
    selectors: list,
):
    """Capture as many frames as needed so every form field appears, fully
    in-viewport, in at least one screenshot.

    Strategy: repeatedly pick the first field not yet covered, scroll it into
    view, take a frame, and mark every field whose bbox center now lies inside
    the viewport as covered. Stops when every field is covered, or when a pass
    makes no progress (safety net against pathological forms).

    Frame suffixes are ``a``, ``b``, ``c``, … in capture order. Each sidecar
    contains bboxes for every field in the original declaration order (with
    the per-frame viewport), so the guide renderer can decide per frame which
    fields to animate.
    """
    if not SCREENSHOTS_ENABLED:
        return
    if not selectors:
        return

    _vp = page.viewport_size or _get_viewport_for_layout(CURRENT_LAYOUT)
    vw = _vp.get("width", 1280)
    vh = _vp.get("height", 720)

    def _in_viewport(bbox):
        if not bbox:
            return False
        cx = bbox.get("x", 0) + bbox.get("width", 0) / 2
        cy = bbox.get("y", 0) + bbox.get("height", 0) / 2
        return 0 <= cx <= vw and 0 <= cy <= vh

    covered = [False] * len(selectors)
    frame_idx = 0

    while not all(covered) and frame_idx < len(FRAME_LETTERS):
        # Anchor this frame on the first uncovered field.
        try:
            anchor = next(i for i, c in enumerate(covered) if not c)
        except StopIteration:
            break
        _scroll_into_view(page, selectors[anchor])

        bboxes = [_safe_bbox(page, s) for s in selectors]
        newly_covered = [i for i, b in enumerate(bboxes) if _in_viewport(b) and not covered[i]]
        if not newly_covered:
            # No progress — anchor field didn't become visible. Force-mark it so
            # the loop terminates; the guide will fall back to hiding its cursor.
            covered[anchor] = True
            frame_idx += 1
            continue

        for i in newly_covered:
            covered[i] = True

        take_screenshot_with_bbox(
            page,
            scenario,
            step,
            "fill-form",
            selectors=selectors,
            precaptured_bboxes=bboxes,
            frame=FRAME_LETTERS[frame_idx],
        )
        frame_idx += 1
{% if tours_enabled %}


# ── In-app tours (config.yaml `tours.enabled`) ────────────────────────────────
# Plain Python, appended only when tours are on. It rebinds three module-level
# names instead of editing their bodies (callers look them up at call time), so
# the hooks and helpers above stay byte-identical for tours-off projects.
#
# * every browser context gets the overlay's kill switch, so an app that starts
#   a tour on its own cannot cover the elements an unrelated test clicks; the
#   tour replay (`test_<slug>__tour`) lifts it for itself;
# * a replay writes no coverage record (it would overwrite the scenario's);
# * `steppy run --guide` deselects replays: guide captures are not tours.
_TOURS_KILL_SWITCH_JS = "globalThis.__STEPPY_TOURS_DISABLED__ = true;"


def _tours_replay_role(node):
    """The role a `test_<slug>__tour` function was generated for, else None."""
    return getattr(getattr(node, "function", None), "_steppy_tour_role", None)


def _tours_with_kill_switch(build):
    def _new_role_context(browser, role, **extra):
        context = build(browser, role, **extra)
        context.add_init_script(_TOURS_KILL_SWITCH_JS)
        return context

    return _new_role_context


def _tours_skip_replay_coverage(write):
    def _coverage_stop_and_write(state, request):
        if state is not None and _tours_replay_role(request.node) is not None:
            cdp = state.get("cdp")
            if cdp is not None:
                try:
                    cdp.detach()
                except Exception:
                    pass
            return
        write(state, request)

    return _coverage_stop_and_write


def _tours_deselect_in_guide_mode(hook):
    def pytest_collection_modifyitems(config, items):
        if GUIDE_MODE:
