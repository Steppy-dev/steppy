    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# Always private. A run report has no SEO value, and ADR 0013 is emphatic
       that a published Pages site means permanently indexed screenshots — so
       there is deliberately no config knob to turn this off. The guides site
       keeps its own SeoConfig for the case where publishing IS the point.

       This meta is the real control: robots.txt only stops the fetch, and a
       crawler that never fetches the page never learns it is noindex. #}
    <meta name="robots" content="noindex,nofollow,noarchive">
    <title>{{ page_title }}</title>
    <link rel="stylesheet" href="{{ root }}assets/report.css">
