{# The report's icons: one sprite per page, referenced with <use>, so a page with a
   thousand cells carries each shape once. Line icons on a 16px grid, coloured by the
   text they sit in. Symbol ids hold a slash: no link fragment can be one.

   icon(name)         decorative: the words beside it say the same.
   icon(name, label)  on its own: the label is read instead.
#}
{% macro icon(name, label='', size=16) -%}
<svg class="steppy-icon steppy-icon--{{ name }}" width="{{ size }}" height="{{ size }}"{% if label %} role="img" aria-label="{{ label }}"{% else %} aria-hidden="true"{% endif %}><use href="#i/{{ name if name in ('passed', 'failed', 'flaky', 'skipped', 'not_run', 'unknown', 'error', 'interrupted', 'worker_died', 'branch', 'external', 'link', 'chevron', 'left', 'right', 'image', 'info', 'desktop', 'tablet', 'mobile', 'file') else 'failed' }}"/></svg>
{%- endmacro %}

{% macro sprite() -%}
<svg width="0" height="0" class="steppy-sprite" aria-hidden="true">
    <defs>
        <symbol id="i/passed" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M5.2 8.2l2 2 3.7-4.3"/></symbol>
        <symbol id="i/failed" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M5.9 5.9l4.2 4.2M10.1 5.9l-4.2 4.2"/></symbol>
        <symbol id="i/error" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M5.9 5.9l4.2 4.2M10.1 5.9l-4.2 4.2"/></symbol>
        <symbol id="i/interrupted" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M5.9 5.9l4.2 4.2M10.1 5.9l-4.2 4.2"/></symbol>
        <symbol id="i/worker_died" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M5.9 5.9l4.2 4.2M10.1 5.9l-4.2 4.2"/></symbol>
        <symbol id="i/flaky" viewBox="0 0 16 16"><path d="M8 2L14.6 13.6H1.4Z"/><path d="M8 6.4v3.4M8 11.7v.1"/></symbol>
        <symbol id="i/skipped" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M5.2 8h5.6"/></symbol>
        <symbol id="i/not_run" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M5.2 8h5.6"/></symbol>
        <symbol id="i/unknown" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M6.2 6.4c0-1 .8-1.7 1.8-1.7s1.8.7 1.8 1.6c0 1.3-1.8 1.4-1.8 2.6M8 11.2v.1"/></symbol>
        <symbol id="i/branch" viewBox="0 0 16 16"><path d="M6 1.8h4v3.4H6zM1.4 10.8h3.6v3.4H1.4zM11 10.8h3.6v3.4H11zM6.2 10.8h3.6v3.4H6.2zM8 5.2v5.6M3.2 10.8V8h9.6v2.8"/></symbol>
        <symbol id="i/external" viewBox="0 0 16 16"><path d="M9.4 2.4h4.2v4.2M13.6 2.4L7.4 8.6M11.6 9.6v4H2.4V4.4h4"/></symbol>
        <symbol id="i/link" viewBox="0 0 16 16"><path d="M6.8 9.2a2.6 2.6 0 0 0 3.7 0l2.4-2.4a2.6 2.6 0 0 0-3.7-3.7L8.3 4M9.2 6.8a2.6 2.6 0 0 0-3.7 0L3.1 9.2a2.6 2.6 0 0 0 3.7 3.7l.9-.9"/></symbol>
        <symbol id="i/chevron" viewBox="0 0 16 16"><path d="M6 3.2L10.8 8 6 12.8"/></symbol>
        <symbol id="i/left" viewBox="0 0 16 16"><path d="M13.6 8H2.4M6.6 3.8L2.4 8l4.2 4.2"/></symbol>
        <symbol id="i/right" viewBox="0 0 16 16"><path d="M2.4 8h11.2M9.4 3.8L13.6 8l-4.2 4.2"/></symbol>
        <symbol id="i/image" viewBox="0 0 16 16"><rect x="1.6" y="2.4" width="12.8" height="11.2" rx="1.6"/><circle cx="5.4" cy="6" r="1.1"/><path d="M1.8 12l4-3.4 2.4 2 2.6-2.8 3.6 3.6"/></symbol>
        <symbol id="i/info" viewBox="0 0 16 16"><circle cx="8" cy="8" r="6.5"/><path d="M8 7.4v3.8M8 4.9v.1"/></symbol>
        <symbol id="i/desktop" viewBox="0 0 16 16"><rect x="1.4" y="2.4" width="13.2" height="8.8" rx="1.2"/><path d="M8 11.2v2.6M5 13.8h6"/></symbol>
        <symbol id="i/tablet" viewBox="0 0 16 16"><rect x="3" y="1.4" width="10" height="13.2" rx="1.4"/><path d="M7.2 12.2h1.6"/></symbol>
        <symbol id="i/mobile" viewBox="0 0 16 16"><rect x="4.4" y="1.4" width="7.2" height="13.2" rx="1.4"/><path d="M7.4 12.2h1.2"/></symbol>
        <symbol id="i/file" viewBox="0 0 16 16"><path d="M3.6 1.6h5.6l3.2 3.2v9.6H3.6zM9 1.8v3.2h3.2"/></symbol>
    </defs>
</svg>
{%- endmacro %}

{# A status: a chip with an icon and a word, never colour alone. #}
{% macro chip(status, words) -%}
<span class="steppy-chip" data-outcome="{{ status }}">{{ icon(status, size=14) }}<span>{{ words }}</span></span>
{%- endmacro %}
