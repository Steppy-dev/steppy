{# Run report landing page, in the order of Steppy Cloud's run page: the run and its
   verdict, warnings, failure causes, every scenario, then the first failing variant.
   Rendered with autoescape ON — every value below comes from a bundle, and a failure
   tail is arbitrary page content. #}
{% from "report/_icons.html.j2" import icon, chip, sprite %}
{% from "report/_shot.html.j2" import thumb %}
{% from "report/_variant.html.j2" import variant_card %}
{% set here = 'run' %}
{% set header = view.header %}
<!doctype html>
<html lang="en">
<head>
{% include "report/_head.html.j2" %}
{% include "report/_links.html.j2" %}
</head>
<body>
    {{ sprite() }}
    {% include "report/_topbar.html.j2" %}

    <main class="steppy-report-main">

        <section class="steppy-report-header steppy-report-section" aria-labelledby="ui/run">
            <h1 id="ui/run">{{ title }} · <span class="steppy-mono">{{ report.run.run_id }}</span></h1>
            <p class="steppy-verdict" data-outcome="{{ report.totals.verdict }}">{{ header.verdict }}</p>
            {% if header.counts %}
            <p class="steppy-counts">
                {% for count in header.counts %}{{ chip(count.status, count.words) }}{% endfor %}
                <span class="steppy-counts-of">{{ header.of }}</span>
            </p>
            {% endif %}
            <p class="steppy-report-meta">
                {% if header.branch %}
                <span>{{ icon('branch', size=14) }}<span class="steppy-sr">Branch </span><span class="steppy-code">{{ header.branch }}</span></span>
                {% endif %}
                {% if header.change or header.base_branch %}
                <span>
                    {% if header.change %}<span class="steppy-tag">{{ header.change }}</span>{% endif %}
                    {% if header.base_branch %}into <span class="steppy-code">{{ header.base_branch }}</span>{% endif %}
                </span>
                {% endif %}
                {% if header.commit %}
                <span>commit <span class="steppy-code" title="{{ header.sha }}">{{ header.commit }}</span></span>
                {% endif %}
                {% if header.tested_as %}
                <span>tested as <span class="steppy-code" title="{{ header.tested_sha }}">{{ header.tested_as }}</span></span>
                {% endif %}
                {% if header.dirty %}
                <span><span class="steppy-tag">uncommitted changes</span></span>
                {% endif %}
                {% if header.environment %}
                <span>on <span class="steppy-tag">{{ header.environment }}</span></span>
                {% endif %}
                {% if header.ci %}
                <span>
                    {# A link only when the recorded address is http or https: everything in a bundle is untrusted. #}
                    {% if header.ci_url %}
                    <a href="{{ header.ci_url }}" target="_blank" rel="noopener noreferrer">{{ header.ci }}<span class="steppy-sr"> (opens in a new tab)</span></a>{{ icon('external', size=12) }}
                    {% else %}
                    {{ header.ci }}{% if header.ci_text %} <span class="steppy-code">{{ header.ci_text }}</span>{% endif %}
                    {% endif %}
                </span>
                {% endif %}
                <span>{{ header.source }}</span>
                <span><time datetime="{{ header.created_at }}">{{ header.when }}</time></span>
                {% if header.shape %}<span>{{ header.shape }}</span>{% endif %}
                {% if report.run.spec.guide %}<span>guide capture</span>{% endif %}
                {% if report.run.spec.workers and report.run.spec.workers > 1 %}<span>{{ report.run.spec.workers }} workers</span>{% endif %}
                {# Named for what it is: under --workers N this is not wall clock,
                   and a bundle carries no finished_at to compute that from. #}
                {% if report.totals.tests %}<span>{{ report.totals.duration_ms_sum | duration }} of test time</span>{% endif %}
            </p>
        </section>

        {% if report.truncated %}
        <div class="steppy-notice" role="note">{{ icon('info') }}<span>
            <strong>Truncated.</strong> The size budget dropped artifacts that belonged in this
            bundle, so something below may be missing. Screenshots and their sidecars are never
            dropped; the warnings say what was.
        </span></div>
        {% endif %}

        {% if not report.capabilities.step_timeline and report.totals.tests %}
        <div class="steppy-notice" role="note">{{ icon('info') }}<span>
            No per-step timeline was recorded for this run, so the pages below show outcomes
            without step detail. Either the run set <code>STEPPY_STEP_EVENTS=0</code>, it was made
            by a Steppy older than 0.9.1 without <code>--bundle</code>, or the tests were generated
            before per-step markers existed: re-run <code>steppy generate</code> in that case.
        </span></div>
        {% endif %}

        {% if report.totals.tests and report.capabilities.step_screenshots is false %}
        <div class="steppy-notice" role="note">{{ icon('image') }}<span>
            This run took <strong>no step screenshots</strong>. <code>steppy run --screenshots</code>
            takes them.
        </span></div>
        {% endif %}

        {% if not report.totals.tests %}
        <div class="steppy-notice" role="note">{{ icon('info') }}<span>
            This run recorded <strong>no test outcomes</strong>. The scenarios below were
            reconstructed from the captures on disk. Run them with <code>steppy run</code>, which
            writes down outcomes, failure tails and step boundaries (a Steppy older than 0.9.1
            needed <code>steppy run --bundle</code>).
        </span></div>
        {% endif %}

        {% if view.warnings %}
        <div class="steppy-notice steppy-warnings" role="note">{{ icon('flaky') }}<div>
            <span class="steppy-notice-title">{{ view.warnings | length }} warning{{ '' if view.warnings | length == 1 else 's' }} in this report</span>
            <ul>
                {% for warning in view.warnings %}<li>{{ warning }}</li>{% endfor %}
            </ul>
        </div></div>
        {% endif %}

        {% if view.causes %}
        <section class="steppy-report-section steppy-causes" aria-labelledby="ui/causes">
            <div class="steppy-section-head">
                <h2 id="ui/causes">Why it failed</h2>
                <span class="steppy-label steppy-muted">{{ view.causes | length }} cause{{ '' if view.causes | length == 1 else 's' }}, grouped by fingerprint</span>
            </div>
            {% macro group(g) %}
            <li>
                <details class="steppy-group">
                    <summary>{{ icon('chevron') }}<span><span class="steppy-mono steppy-strong">{{ g.scenario }}</span><span class="steppy-muted">{{ g.where }}</span></span><span class="steppy-label steppy-muted">{{ g.count }}</span></summary>
                    <ul class="steppy-chips" aria-label="Variants of {{ g.scenario }}{{ g.where }}">
                        {% for c in g.chips %}
                        <li><a class="steppy-variant-chip" href="{{ c.href }}">{{ icon('failed', size=14) }}<span class="steppy-code">{{ c.name }}</span>{% if c.layout %} <span class="steppy-muted">{{ c.layout }}</span>{% endif %}</a></li>
                        {% endfor %}
                    </ul>
                </details>
            </li>
            {% endmacro %}
            {% for cause in view.causes %}
            <article class="steppy-cause" id="{{ cause.anchor }}"{% if cause.shots %} data-shots{% endif %}>
                <div class="steppy-cause-text">
                    <h3 class="steppy-cause-headline">{{ icon('failed') }}<code>{{ cause.headline }}</code></h3>
                    <p class="steppy-small steppy-muted">{{ cause.line }} <a class="steppy-fingerprint" href="#{{ cause.anchor }}" title="Link to this cause">{{ cause.fingerprint }}</a></p>
                    <ul class="steppy-groups" aria-label="Where this cause hits">
                        {% for g in cause.shown %}{{ group(g) }}{% endfor %}
                    </ul>
                    {% if cause.hidden %}
                    <details class="steppy-more">
                        <summary>Show {{ cause.hidden | length }} more</summary>
                        <ul class="steppy-groups">{% for g in cause.hidden %}{{ group(g) }}{% endfor %}</ul>
                    </details>
                    {% endif %}
                    {% if cause.tail %}
                    <details class="steppy-more">
                        <summary>Last log lines of the first one</summary>
                        <pre class="steppy-tail">{{ cause.tail }}</pre>
                    </details>
                    {% endif %}
                </div>
                {% if cause.shots %}
                <figure class="steppy-cause-shots" data-count="{{ cause.shots | length }}">
                    <figcaption class="steppy-label-strong">At the failure</figcaption>
                    <div>
                        {% for s in cause.shots %}
                        <span class="steppy-cause-shot">
                            {{ thumb(s.shot, root, '%s: open the screenshot in a new tab' % s.shot.alt, 'steppy-cause-image') }}
                            <span class="steppy-caption"><span class="steppy-code">{{ s.name }}</span>{% if s.layout %} · {{ s.layout }}{% endif %}</span>
                        </span>
                        {% endfor %}
                    </div>
                </figure>
                {% endif %}
            </article>
            {% endfor %}
        </section>
        {% endif %}

        {% set matrix = view.matrix %}
        {% macro words(c) %}{{ icon(c.status) }}<span class="steppy-cell-words"><span>{{ c.label }}</span>{% if c.more %}<span class="steppy-sr">{{ c.more }}</span>{% endif %}</span>{% endmacro %}
        {% macro cell(c) %}
        {% if c.href %}
        <a class="steppy-cell" data-outcome="{{ c.status }}" href="{{ c.href }}">{% if c.spoken %}<span class="steppy-sr">{{ c.spoken }}</span>{% endif %}{% if c.layout %}<span class="steppy-cell-layout">{{ c.layout }} </span>{% endif %}{{ words(c) }}</a>
        {% else %}
        <span class="steppy-cell" data-outcome="{{ c.status }}">{% if c.spoken %}<span class="steppy-sr">{{ c.spoken }}</span>{% endif %}{% if c.layout %}<span class="steppy-cell-layout">{{ c.layout }} </span>{% endif %}{{ words(c) }}</span>
        {% endif %}
        {% endmacro %}
        {% macro line(l) %}
        <div class="steppy-line">
            <span class="steppy-line-locale">{{ l.locale }}</span>
            {% for c in l.cells %}{{ cell(c) }}{% endfor %}
        </div>
        {% endmacro %}
        <section class="steppy-report-section steppy-matrix" aria-labelledby="ui/scenarios">
            <div class="steppy-matrix-top">
                <div class="steppy-section-head">
                    <h2 id="ui/scenarios">Scenarios</h2>
                    <span class="steppy-label steppy-muted">{{ matrix.note }}</span>
                </div>
                {% if matrix.total %}
                <fieldset class="steppy-segments">
                    <legend class="steppy-sr">Show</legend>
                    <label><input type="radio" name="show" value="not" id="ui/show-not" autocomplete="off"{% if matrix.not_passing %} checked{% endif %}><span>Not passing {{ matrix.not_passing }}</span></label>
                    <label><input type="radio" name="show" value="all" id="ui/show-all" autocomplete="off"{% if not matrix.not_passing %} checked{% endif %}><span>All {{ matrix.total }}</span></label>
                </fieldset>
                {% endif %}
            </div>
            <div class="steppy-matrix-grid" style="--n:{{ matrix.columns | length }}">
                <div class="steppy-matrix-head" aria-hidden="true">
                    <span>Scenario</span>
                    {% for column in matrix.columns %}<span>{% if column.icon %}{{ icon(column.icon, size=14) }}{% endif %}<span>{{ column.label }}</span></span>{% endfor %}
                </div>
                {% for r in matrix.rows %}
                {% if r.expandable %}
                <details class="steppy-row"{% if not r.not_passing %} data-passing{% endif %}>
                    <summary>
                        <span class="steppy-row-name">{{ icon('chevron') }}<span><span class="steppy-row-slug">{{ r.slug }}</span>{% if r.where %}<span class="steppy-row-where">{{ r.where }}</span>{% endif %}</span></span>
                        {% for c in r.cells %}{{ cell(c) }}{% endfor %}
                    </summary>
                    <div class="steppy-lines">
                        {% for l in r.lines %}{{ line(l) }}{% endfor %}
                        {% if r.folded %}
                        <details class="steppy-fold">
                            <summary>{{ icon('chevron') }}{{ icon('passed', size=14) }}<span>{{ r.fold_label }}</span></summary>
                            {% for l in r.folded %}{{ line(l) }}{% endfor %}
                        </details>
                        {% endif %}
                        <p class="steppy-lines-end"><a href="{{ r.href }}">Open {{ r.slug }}</a></p>
                    </div>
                </details>
                {% else %}
                <div class="steppy-row"{% if not r.not_passing %} data-passing{% endif %}>
                    <div class="steppy-row-line">
                        <span class="steppy-row-name"><span><a class="steppy-row-slug" href="{{ r.href }}">{{ r.slug }}</a>{% if r.where %}<span class="steppy-row-where">{{ r.where }}</span>{% endif %}</span></span>
                        {% for c in r.cells %}{{ cell(c) }}{% endfor %}
                    </div>
                </div>
                {% endif %}
                {% endfor %}
                {% if not matrix.total %}
                <p class="steppy-matrix-empty">No scenario in this run.</p>
                {% else %}
                {% if not matrix.not_passing %}<p class="steppy-matrix-empty steppy-matrix-passing">{{ 'Every scenario passed.' if report.totals.tests else 'No outcome was recorded.' }}</p>{% endif %}
                <p class="steppy-matrix-more"><label for="ui/show-all">Show all {{ matrix.total }} scenarios</label></p>
                {% endif %}
            </div>
        </section>

        <p class="steppy-notice" role="status" id="ui/link-notice" hidden>{{ icon('info') }}<span></span></p>

        {% if view.variant %}
        {{ variant_card(view.variant, root) }}
        {% endif %}

        {% if report.coverage.tier != 'none' %}
        <section class="steppy-report-section steppy-block" aria-labelledby="ui/coverage">
            <div class="steppy-section-head">
                <h2 id="ui/coverage">E2E surface coverage</h2>
                <a class="steppy-label" href="coverage.html">Full gap report</a>
            </div>
            <p class="steppy-badge-line">
                {% if report.coverage.badge.percent is not none %}
                <span class="steppy-pct">{{ report.coverage.badge.percent }}%</span>
                <span class="steppy-muted">
                    {{ report.coverage.badge.tested }} of {{ report.coverage.badge.declared }}
                    declared endpoints and routes a UI test could reach
                </span>
                {% else %}
                <span class="steppy-pct steppy-muted">n/a</span>
                <span class="steppy-muted">nothing declared: configure <code>coverage.apis</code> and run <code>steppy coverage refresh</code></span>
                {% endif %}
            </p>
        </section>
        {% endif %}

        {% if report.artifacts.by_kind %}
        <section class="steppy-report-section steppy-block" aria-labelledby="ui/artifacts">
            <div class="steppy-section-head"><h2 id="ui/artifacts">Artifacts in this run</h2></div>
            <p class="steppy-small steppy-muted">
                What the run produced, by kind. Traces and videos are listed rather than copied
                here: a Playwright trace needs <code>playwright show-trace</code> to open, so a
                link would be a dead end.
            </p>
            <div class="steppy-scroll" tabindex="0" role="region" aria-label="Files by kind">
                <table class="steppy-report-table">
                    <thead><tr><th scope="col">Kind</th><th scope="col">Files</th><th scope="col">Size</th></tr></thead>
                    <tbody>
                        {% for kind, group in report.artifacts.by_kind.items() %}
                        <tr><td>{{ kind }}</td><td>{{ group.count }}</td><td>{{ group.bytes | filesize }}</td></tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </section>
        {% endif %}

    </main>

    <footer class="steppy-report-footer">
        <p>
            Generated by Steppy {{ report.generated_by }} from {{ report.source.kind }}
            <code>{{ report.source.label }}</code>. The run used Steppy {{ report.run.steppy_version }}.
            Machine-readable: <a href="report.json">report.json</a>{% if report.coverage.tier != 'none' %},
            <a href="badge.json">badge.json</a>{% endif %}.
        </p>
        <p>
            This page is marked <code>noindex</code>. It is a run report, not documentation,
            and a published Pages site means published screenshots.
        </p>
    </footer>
</body>
</html>
