{# One scenario, one page: every (locale, layout) variant with its step timeline.
   This is where the report earns its keep over a JUnit report — the failing step
   is named and shown, not inferred from a stack trace. Autoescape is ON. #}
<!doctype html>
<html lang="en">
<head>
{% include "report/_head.html.j2" %}
</head>
<body>
    <header class="steppy-report-header">
        <h1>{% include "report/_mark.html.j2" %}{{ scenario.slug }}</h1>
        <p class="steppy-report-meta steppy-small">
            <span><a href="{{ root }}index.html">&larr; All scenarios</a></span>
            <span><span class="steppy-chip" data-outcome="{{ scenario.outcome }}">{{ scenario.outcome }}</span></span>
            <span>{{ scenario.variants | length }} variant{{ '' if scenario.variants | length == 1 else 's' }}</span>
            <span>{{ scenario.duration_ms_sum | duration }} test time</span>
        </p>
    </header>

    <main class="steppy-report-main">

        {% if not scenario.variants %}
        <div class="steppy-notice">
            No test outcome was recorded for this scenario. Its captures are on disk, but the run
            wrote down nothing about whether it passed — add <code>--bundle</code> to
            <code>steppy run</code>.
        </div>
        {% endif %}

        {% if scenario.failure_log %}
        <div class="steppy-notice">
            A worker log for this scenario is in the run at
            <code>{{ scenario.failure_log }}</code>. It is not copied into this site.
        </div>
        {% endif %}

        {% for variant in scenario.variants %}
        <section class="steppy-variant">
            <div class="steppy-variant-head">
                <h3>{{ variant_label(variant) }}</h3>
                <span class="steppy-chip" data-outcome="{{ variant.outcome }}">{{ variant.outcome }}</span>
                {% if variant.duration_ms is not none %}
                <span class="steppy-muted steppy-small">{{ variant.duration_ms | duration }}</span>
                {% endif %}
                {% if variant.attempts > 1 %}
                {# Only ever visible for in-process pytest --reruns: the parallel
                   retry pass runs a fresh process, which truncates the JSONL and
                   takes attempt 1 with it. #}
                <span class="steppy-chip" data-outcome="unknown">attempt {{ variant.attempts }} of {{ variant.attempts }}</span>
                {% endif %}
            </div>
            <p class="steppy-nodeid">{{ variant.nodeid }}</p>

            {% if variant.failed_step is not none %}
            {# ``{%- ... -%}`` throughout: trim_blocks eats the newline after a block
               tag but lstrip_blocks only strips before one, so a tag at end of line
               leaves the next line's indentation in the middle of a sentence. #}
            <p class="steppy-small">
                <strong>Failed at step {{ variant.failed_step }}</strong>
                {%- if variant.failed_step_title %} — {{ variant.failed_step_title }}{% endif %}.
                {%- if variant.fingerprint %}
                <a href="{{ root }}index.html#cause-{{ variant.fingerprint }}">cause {{ variant.fingerprint }}</a>
                {%- endif %}
            </p>
            {% elif variant.outcome not in ('passed', 'skipped') %}
            <p class="steppy-small steppy-muted">
                No step was in flight when this test died — it failed in fixture setup or
                teardown, or between steps. Blaming the last step reached would point at working
                code.
            </p>
            {% endif %}

            {% if variant.fail_tail %}
            <pre class="steppy-tail">{{ variant.fail_tail }}</pre>
            {% endif %}

            {% if variant.failure_screenshot %}
            <div class="steppy-shots">
                <a href="{{ root }}{{ variant.failure_screenshot }}">
                    <img src="{{ root }}{{ variant.failure_screenshot }}" alt="Page at the moment of failure" loading="lazy">
                </a>
            </div>
            {% endif %}

            {% if variant.steps %}
            <ol class="steppy-steps">
                {% for step in variant.steps %}
                {# Step numbers are the SCENARIO's and are sparse — a step skipped
                   by only-in:/layouts: emits nothing. Rendered as-is, never
                   renumbered, so "step 7" means step 7 of the markdown. #}
                <li class="steppy-step" data-status="{{ step.status }}">
                    <span class="steppy-step-num">{{ '%02d' | format(step.step) }}</span>
                    <div class="steppy-step-body">
                        <div class="steppy-step-title">{{ step.title or '(untitled step)' }}</div>
                        <div class="steppy-step-facts">
                            <span class="steppy-step-action">{{ step.action }}</span>
                            <span>+{{ step.offset_ms | duration }}</span>
                            {% if step.duration_ms is not none %}
                            <span>took {{ step.duration_ms | duration }}</span>
                            {% else %}
                            <span>never finished</span>
                            {% endif %}
                        </div>
                        {% if step.screenshots %}
                        <div class="steppy-shots">
                            {% for url in step.screenshots %}
                            <a href="{{ root }}{{ url }}"><img src="{{ root }}{{ url }}" alt="Step {{ step.step }}" loading="lazy"></a>
                            {% endfor %}
                        </div>
                        {% endif %}
                    </div>
                </li>
                {% endfor %}
            </ol>
            {% endif %}

            {% if variant.trace_path or variant.video_path %}
            <p class="steppy-small steppy-muted">
                {% if variant.trace_path %}
                Trace in the run at <code>{{ variant.trace_path }}</code>
                (open with <code>playwright show-trace</code>).
                {% endif %}
                {% if variant.video_path %}
                Video at <code>{{ variant.video_path }}</code>.
                {% endif %}
            </p>
            {% endif %}
        </section>
        {% endfor %}

    </main>

    <footer class="steppy-report-footer">
        <p><a href="{{ root }}index.html">&larr; All scenarios</a></p>
    </footer>
</body>
</html>
