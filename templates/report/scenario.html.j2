{# One scenario, one page: every (locale, layout) variant with its step timeline.
   This is where the report earns its keep over a JUnit report — the failing step
   is named and shown, not inferred from a stack trace. Every variant and every step
   carries its link as its id, so a link works with no script. Autoescape is ON. #}
{% from "report/_icons.html.j2" import icon, chip, sprite %}
{% from "report/_variant.html.j2" import variant_card, hide_target %}
{% set here = 'scenario' %}
<!doctype html>
<html lang="en">
<head>
{% include "report/_head.html.j2" %}
{% include "report/_links.html.j2" %}
</head>
<body>
    {{ sprite() }}
    {% include "report/_topbar.html.j2" %}

    <main class="steppy-report-main">

        <nav class="steppy-crumbs" aria-label="Breadcrumb">
            <ol><li><a href="{{ root }}index.html">Run report</a></li><li aria-current="page">{{ page.slug }}</li></ol>
        </nav>

        <header class="steppy-scenario-head">
            <div class="steppy-scenario-title">
                <h1>{{ page.slug }}</h1>
                {{ chip(page.status, page.word) }}
            </div>
            <p class="steppy-report-meta">
                <span>As in <a href="{{ root }}index.html">{{ report.run.run_id }}</a>{% if view.header.branch %} on <span class="steppy-code">{{ view.header.branch }}</span>{% endif %}</span>
                {% if page.variants %}<span>{{ page.duration_ms | duration }} of test time</span>{% endif %}
            </p>
        </header>

        {% if not page.variants %}
        <div class="steppy-notice" role="note">{{ icon('info') }}<span>
            No test outcome was recorded for this scenario. Its captures are on disk, but the run
            wrote down nothing about whether it passed. Run it with <code>steppy run</code>
            (a Steppy older than 0.9.1 needed <code>--bundle</code>).
        </span></div>
        {% endif %}

        {% if page.failure_log %}
        <div class="steppy-notice" role="note">{{ icon('file') }}<span>
            A worker log for this scenario is in the run at
            <code>{{ page.failure_log }}</code>. It is not copied into this site.
        </span></div>
        {% endif %}

        <p class="steppy-notice" role="status" id="ui/link-notice" hidden>{{ icon('info') }}<span></span></p>

        {% if page.variants %}
        {% set grid = page.variants | length > 1 or page.lines | length > 1 or page.columns | length > 1 %}
        <div class="steppy-scenario"{% if grid %} data-grid{% endif %}>
            <div class="steppy-scenario-side">
                {% if grid %}
                {% macro cell(c) %}
                {% if c.href %}
                <a class="steppy-cell" data-outcome="{{ c.status }}" href="{{ root }}{{ c.href }}"><span class="steppy-sr">{{ c.spoken }}</span>{% if c.layout %}<span class="steppy-cell-layout">{{ c.layout }} </span>{% endif %}{{ icon(c.status) }}<span class="steppy-cell-words">{{ c.word }}</span></a>
                {% else %}
                <span class="steppy-cell" data-outcome="{{ c.status }}"><span class="steppy-sr">{{ c.spoken }}</span>{% if c.layout %}<span class="steppy-cell-layout">{{ c.layout }} </span>{% endif %}{{ icon(c.status) }}<span class="steppy-cell-words">{{ c.word }}</span></span>
                {% endif %}
                {% endmacro %}
                {% macro line(l) %}
                <div class="steppy-line">
                    <span class="steppy-line-locale">{{ l.locale }}</span>
                    {% for c in l.cells %}{{ cell(c) }}{% endfor %}
                </div>
                {% endmacro %}
                <section class="steppy-report-section steppy-variants-grid" aria-labelledby="ui/variants">
                    <div class="steppy-grid-top">
                        <h2 id="ui/variants">Variants in this run</h2>
                        <p class="steppy-label steppy-muted"><span class="steppy-where">{{ page.where }}</span> · {{ page.size }}</p>
                        <p class="steppy-counts">{% for count in page.counts %}{{ chip(count.status, count.words) }}{% endfor %}</p>
                    </div>
                    <div class="steppy-grid-rows" style="--n:{{ page.columns | length }}">
                        {% if view.has_layouts %}
                        <div class="steppy-grid-head" aria-hidden="true">
                            <span></span>
                            {% for column in page.columns %}<span>{% if column.icon %}{{ icon(column.icon) }}{% endif %}<span>{{ column.label }}</span></span>{% endfor %}
                        </div>
                        {% endif %}
                        {% for l in page.lines %}{{ line(l) }}{% endfor %}
                        {% if page.folded %}
                        <details class="steppy-fold">
                            <summary>{{ icon('chevron') }}{{ icon('passed', size=14) }}<span>{{ page.fold_label }}</span></summary>
                            {% for l in page.folded %}{{ line(l) }}{% endfor %}
                        </details>
                        {% endif %}
                    </div>
                </section>
                {% endif %}
            </div>
            <section class="steppy-scenario-variants" aria-labelledby="ui/steps">
                <div class="steppy-section-head">
                    <h2 id="ui/steps">Steps</h2>
                    {% if page.has_marks %}{{ hide_target() }}{% endif %}
                </div>
                {% for v in page.variants %}
                {# What #<scenario> opens: its first failing variant, else its first. #}
                {% if v.anchor == page.first and not v.extra %}<span class="steppy-anchor" id="{{ links.anchor }}"></span>{% endif %}
                {{ variant_card(v, root, large=true) }}
                {% endfor %}
            </section>
        </div>
        {% endif %}

    </main>

    <footer class="steppy-report-footer">
        <p><a href="{{ root }}index.html">Back to the run report</a></p>
    </footer>
</body>
</html>
