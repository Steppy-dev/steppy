<!doctype html>
<html lang="{{ html_lang | default(current_locale, true) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pick_locale(group.title, current_locale, default_locale) }} — {{ pick_locale(site_title, current_locale, default_locale) }}</title>
    {% include "static/_seo_head.html.j2" %}
    <link rel="stylesheet" href="../assets/guides.css">
</head>
<body>
    <header class="steppy-site-header">
        <a class="steppy-site-title" href="{{ index_href }}">{{ pick_locale(site_title, current_locale, default_locale) }}</a>
        <nav class="steppy-breadcrumb" aria-label="Breadcrumb">
            <a href="{{ index_href }}">Home</a>
            <span class="steppy-breadcrumb-sep">›</span>
            <span aria-current="page">{{ pick_locale(group.title, current_locale, default_locale) }}</span>
        </nav>
        {% if locales | length > 1 %}
        <nav class="steppy-locale-switch" aria-label="Language">
            <ul>
                {% for link in lang_links %}
                <li>
                    {% if link.active %}
                    <span aria-current="true">{{ link.label }}</span>
                    {% else %}
                    <a href="{{ link.href }}">{{ link.label }}</a>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
    </header>

    <main class="steppy-main">
        <section class="steppy-index">
            <h1>{{ pick_locale(group.title, current_locale, default_locale) }}</h1>
            {% set desc = pick_locale(group.description, current_locale, default_locale) %}
            {% if desc %}
            <p class="steppy-group-description">{{ desc }}</p>
            {% endif %}
            {% if children %}
            <ul class="steppy-index-list">
                {% for child in children %}
                {% if child.kind == 'group' %}
                <li class="steppy-index-group">
                    <a href="../{{ child.slug }}/{{ current_locale }}.html">
                        <span class="steppy-index-eyebrow">Module</span>
                        <span class="steppy-index-title">{{ pick_locale(child.title, current_locale, default_locale) }}</span>
                        {% if child.child_count is defined %}
                        <span class="steppy-index-meta">{{ child.child_count }} guides</span>
                        {% endif %}
                        {% set desc = pick_locale(child.description, current_locale, default_locale) %}
                        {% if desc %}
                        <span class="steppy-index-desc">{{ desc }}</span>
                        {% endif %}
                    </a>
                </li>
                {% else %}
                <li>
                    <a href="../{{ child.slug }}/{{ current_locale }}.html">
                        <span class="steppy-index-title">{{ pick_locale(child.title, current_locale, default_locale) }}</span>
                    </a>
                </li>
                {% endif %}
                {% endfor %}
            </ul>
            {% else %}
            <p class="steppy-index-empty">{{ empty_label }}</p>
            {% endif %}
        </section>
    </main>

    <footer class="steppy-site-footer">
        <p>Generated by Steppy.</p>
    </footer>
</body>
</html>
