<!doctype html>
<html lang="{{ html_lang | default(current_locale, true) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pick_locale(site_title, current_locale, default_locale) }}</title>
    {% include "static/_seo_head.html.j2" %}
    <link rel="stylesheet" href="./assets/guides.css">
</head>
<body>
    <header class="steppy-site-header">
        <span class="steppy-site-title">{{ pick_locale(site_title, current_locale, default_locale) }}</span>
        {% if locales | length > 1 %}
        <nav class="steppy-locale-switch" aria-label="Language">
            <ul>
                {% for link in lang_links %}
                <li>
                    {% if link.active %}
                    <span aria-current="true">{{ link.label }}</span>
                    {% else %}
                    <a href="{{ link.href }}">{{ link.label }}</a>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
    </header>

    <main class="steppy-main">
        <section class="steppy-index">
            <h1>{{ pick_locale(site_title, current_locale, default_locale) }}</h1>
            <ul class="steppy-index-list">
                {% for node in navigation %}
                {% if node.kind == 'onboarding' %}
                <li class="steppy-index-onboarding">
                    <a href="./{{ onboarding_slug }}/{{ current_locale }}.html">
                        <span class="steppy-index-eyebrow">{{ onboarding_eyebrow }}</span>
                        <span class="steppy-index-title">{{ pick_locale(node.title, current_locale, default_locale) }}</span>
                        <span class="steppy-index-meta">{{ node.guides | length }} {{ steps_label }}</span>
                    </a>
                </li>
                {% elif node.kind == 'group' %}
                <li class="steppy-index-group">
                    <a href="./{{ node.slug }}/{{ current_locale }}.html">
                        <span class="steppy-index-eyebrow">{{ group_eyebrow }}</span>
                        <span class="steppy-index-title">{{ pick_locale(node.title, current_locale, default_locale) }}</span>
                        <span class="steppy-index-meta">{{ node.children | length }} {{ guides_label }}</span>
                        {% set desc = pick_locale(node.description, current_locale, default_locale) %}
                        {% if desc %}
                        <span class="steppy-index-desc">{{ desc }}</span>
                        {% endif %}
                    </a>
                </li>
                {% else %}
                <li>
                    <a href="./{{ node.slug }}/{{ current_locale }}.html">
                        <span class="steppy-index-title">{{ pick_locale(node.title, current_locale, default_locale) }}</span>
                    </a>
                </li>
                {% endif %}
                {% endfor %}
            </ul>
            {% if handbook_url %}
            <p class="steppy-index-handbook">
                <a href="{{ handbook_url }}">{{ handbook_label | default('Full handbook', true) }}</a>
                {% if handbook_pdf_url %}
                <a class="steppy-pdf-link" href="{{ handbook_pdf_url }}" download>PDF</a>
                {% endif %}
            </p>
            {% endif %}
        </section>
    </main>

    <footer class="steppy-site-footer">
        <p>Generated by Steppy.</p>
    </footer>
</body>
</html>
