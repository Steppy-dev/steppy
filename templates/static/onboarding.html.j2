<!doctype html>
<html lang="{{ html_lang | default(current_locale, true) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pick_locale(onboarding.title, current_locale, default_locale) }} — {{ pick_locale(site_title, current_locale, default_locale) }}</title>
    {% include "static/_seo_head.html.j2" %}
    <link rel="stylesheet" href="../assets/guides.css">
</head>
<body>
    <header class="steppy-site-header">
        <a class="steppy-site-title" href="{{ index_href }}">{{ pick_locale(site_title, current_locale, default_locale) }}</a>
        <nav class="steppy-breadcrumb" aria-label="Breadcrumb">
            <a href="{{ index_href }}">Home</a>
            <span class="steppy-breadcrumb-sep">›</span>
            <span aria-current="page">{{ pick_locale(onboarding.title, current_locale, default_locale) }}</span>
        </nav>
        {% if locales | length > 1 %}
        <nav class="steppy-locale-switch" aria-label="Language">
            <ul>
                {% for link in lang_links %}
                <li>
                    {% if link.active %}
                    <span aria-current="true">{{ link.label }}</span>
                    {% else %}
                    <a href="{{ link.href }}">{{ link.label }}</a>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
    </header>

    <main class="steppy-main">
        <section class="steppy-onboarding">
            <h1>{{ pick_locale(onboarding.title, current_locale, default_locale) }}</h1>
            {% set desc = pick_locale(onboarding.description, current_locale, default_locale) %}
            {% if desc %}
            <p class="steppy-onboarding-description">{{ desc }}</p>
            {% endif %}
            <ol class="steppy-onboarding-steps">
                {% for step in steps %}
                <li>
                    <a href="../{{ step.slug }}/{{ current_locale }}.html?onboarding=1">
                        <span class="steppy-onboarding-step-number">{{ loop.index }}</span>
                        <span class="steppy-onboarding-step-title">{{ pick_locale(step.title, current_locale, default_locale) }}</span>
                    </a>
                </li>
                {% endfor %}
            </ol>
            {% if steps %}
            <p class="steppy-onboarding-cta">
                <a class="steppy-onboarding-start" href="../{{ steps[0].slug }}/{{ current_locale }}.html?onboarding=1">{{ start_label }}</a>
            </p>
            {% endif %}
        </section>
    </main>

    <footer class="steppy-site-footer">
        <p>Generated by Steppy.</p>
    </footer>
</body>
</html>
