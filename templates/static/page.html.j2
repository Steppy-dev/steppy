<!doctype html>
<html lang="{{ html_lang | default(locale, true) }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ pick_locale(entry.title, locale, default_locale) }} — {{ pick_locale(site_title, locale, default_locale) }}</title>
    {% include "static/_seo_head.html.j2" %}
    <link rel="stylesheet" href="../assets/guides.css">
</head>
<body{% if layouts %} data-active-layout="{{ default_layout }}"{% endif %}>
    <header class="steppy-site-header">
        <a class="steppy-site-title" href="{{ index_href }}">{{ pick_locale(site_title, locale, default_locale) }}</a>
        <nav class="steppy-breadcrumb" aria-label="Breadcrumb">
            <a href="{{ index_href }}">Home</a>
            <span class="steppy-breadcrumb-sep">›</span>
            {% if group %}
            <a href="../{{ group.slug }}/{{ locale }}.html">{{ pick_locale(group.title, locale, default_locale) }}</a>
            <span class="steppy-breadcrumb-sep">›</span>
            {% endif %}
            <span aria-current="page">{{ pick_locale(entry.title, locale, default_locale) }}</span>
        </nav>
        {% if locales | length > 1 %}
        <nav class="steppy-locale-switch" aria-label="Language">
            <ul>
                {% for link in lang_links %}
                <li>
                    {% if link.active %}
                    <span aria-current="true">{{ link.label }}</span>
                    {% else %}
                    <a href="{{ link.href }}">{{ link.label }}</a>
                    {% endif %}
                </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
        {% if pdf_url %}
        <a class="steppy-pdf-link" href="{{ pdf_url }}" download>PDF</a>
        {% endif %}
        {% include "static/_mode_links.html.j2" %}
        {% if layouts | length > 1 %}
        <nav class="steppy-layout-switch" aria-label="Layout">
            <ul>
                {% for layout in layouts %}
                <li>
                    <button type="button" data-layout="{{ layout }}" {% if layout == default_layout %}aria-current="true"{% endif %}>{{ layout | capitalize }}</button>
                </li>
                {% endfor %}
            </ul>
        </nav>
        {% endif %}
    </header>

    {% if onboarding_strip %}
    <nav class="steppy-onboarding-strip" aria-label="Onboarding progress">
        <span class="steppy-onboarding-strip-progress">
            <a href="../{{ onboarding_strip.path_slug }}/{{ locale }}.html">{{ pick_locale(onboarding_strip.title, locale, default_locale) }}</a>
            — {{ onboarding_strip.position_label }}
        </span>
        <span class="steppy-onboarding-strip-nav">
            {% if onboarding_strip.prev %}
            <a class="steppy-onboarding-prev" href="../{{ onboarding_strip.prev.slug }}/{{ locale }}.html?onboarding=1">‹ {{ pick_locale(onboarding_strip.prev.title, locale, default_locale) }}</a>
            {% else %}
            <span class="steppy-onboarding-prev steppy-onboarding-disabled" aria-disabled="true">‹ {{ onboarding_strip.prev_label }}</span>
            {% endif %}
            {% if onboarding_strip.next %}
            <a class="steppy-onboarding-next" href="../{{ onboarding_strip.next.slug }}/{{ locale }}.html?onboarding=1">{{ pick_locale(onboarding_strip.next.title, locale, default_locale) }} ›</a>
            {% else %}
            <span class="steppy-onboarding-next steppy-onboarding-disabled" aria-disabled="true">{{ onboarding_strip.done_label }}</span>
            {% endif %}
        </span>
    </nav>
    {% endif %}

    <main class="steppy-main">
        {% if layouts %}
        {%- for layout in layouts %}
        <div class="steppy-layout{% if layout == default_layout %} steppy-layout-active{% endif %}" data-layout="{{ layout }}">
            {{ fragments_by_layout[layout] | safe }}
        </div>
        {%- endfor %}
        {% else %}
        {{ fragments_by_layout['default'] | safe }}
        {% endif %}
    </main>

    <footer class="steppy-site-footer">
        <p>Generated by Steppy.</p>
    </footer>

    <script>
      {% if layouts %}
      window.__STEPPY_STEPS_BY_LAYOUT__ = {{ steps_by_layout | tojson }};
      window.__STEPPY_STEPS__ = window.__STEPPY_STEPS_BY_LAYOUT__[{{ default_layout | tojson }}] || [];
      window.__STEPPY_ACTIVE_LAYOUT__ = {{ default_layout | tojson }};
      {% else %}
      window.__STEPPY_STEPS__ = {{ steps_by_layout['default'] | tojson }};
      {% endif %}
      window.__STEPPY_TIMINGS__ = {{ cursor_timings | tojson }};
    </script>
    {% if layouts | length > 1 %}
    <script>
      (function () {
        const persistKey = 'steppy:active-layout';
        const persisted = (function () {
          try { return localStorage.getItem(persistKey); } catch (_) { return null; }
        })();
        const layouts = {{ layouts | tojson }};
        const initial = (persisted && layouts.indexOf(persisted) !== -1)
          ? persisted
          : {{ default_layout | tojson }};
        function applyLayout(name) {
          if (layouts.indexOf(name) === -1) return;
          document.body.setAttribute('data-active-layout', name);
          document.querySelectorAll('.steppy-layout').forEach(function (el) {
            if (el.getAttribute('data-layout') === name) {
              el.classList.add('steppy-layout-active');
            } else {
              el.classList.remove('steppy-layout-active');
            }
          });
          document.querySelectorAll('.steppy-layout-switch button').forEach(function (b) {
            if (b.getAttribute('data-layout') === name) {
              b.setAttribute('aria-current', 'true');
            } else {
              b.removeAttribute('aria-current');
            }
          });
          if (window.__STEPPY_STEPS_BY_LAYOUT__) {
            window.__STEPPY_STEPS__ = window.__STEPPY_STEPS_BY_LAYOUT__[name] || [];
            window.__STEPPY_ACTIVE_LAYOUT__ = name;
          }
          try { localStorage.setItem(persistKey, name); } catch (_) {}
          document.dispatchEvent(new CustomEvent('steppy:layout-change', { detail: { layout: name } }));
        }
        applyLayout(initial);
        document.querySelectorAll('.steppy-layout-switch button').forEach(function (b) {
          b.addEventListener('click', function () { applyLayout(b.getAttribute('data-layout')); });
        });
      })();
    </script>
    {% endif %}
    <script src="../assets/cursor.js" defer></script>
</body>
</html>
