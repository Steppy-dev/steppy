        _toggle.click()
{% endif %}
{% elif step.state == "off" %}
    if _content.is_visible():
        _toggle.click()
        _content.wait_for(state="hidden", timeout={{ step | resolve_timeout(scenario, config) }})
{% else %}
    if not _content.is_visible():
        _toggle.click()
        _content.wait_for(state="visible", timeout={{ step | resolve_timeout(scenario, config) }})
{% endif %}
{% if step.wait_after %}
