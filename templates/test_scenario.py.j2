@pytest.fixture(autouse=True)
def seed():
    """Run seed script {{ scenario.seed.run }} this scenario."""
    import subprocess
    import sys
    from pathlib import Path

    seed_file = Path({{ ('seed/' ~ scenario.seed.script ~ '.py') | pystr }})

    if not seed_file.exists():
        pytest.fail(f'Seed script not found: {seed_file}')

    def _run_seed():
        try:
            result = subprocess.run(
                [sys.executable, str(seed_file)],
                capture_output=True,
                text=True,
                timeout={{ scenario.seed.timeout }},
            )
        except subprocess.TimeoutExpired:
            pytest.fail(f'Seed script timed out after {{ scenario.seed.timeout }}s: {seed_file}')
        if result.returncode != 0:
            error_msg = f'Seed script failed (exit code {result.returncode})'
            if result.stderr:
                error_msg += f'\nStderr: {result.stderr}'
            if result.stdout:
                error_msg += f'\nStdout: {result.stdout}'
            pytest.fail(error_msg)

{% if scenario.seed.run in ("before", "both") %}
    _run_seed()
{% endif %}

