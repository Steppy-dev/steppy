{#
  One screenshot capture, guarded.

  Every interactive action repeats the same scaffold: capture `_bbox`, emit a
  pre-action shot when `screenshot-when: before`, run the action, emit a
  post-action shot otherwise. This macro owns the guard and the kwargs so a new
  action writes two `shot(...)` lines instead of copy-pasting eight.

  `when` is "before" or "after" and is matched against the step's
  `screenshot-when`. `selector`/`bbox`/`highlight` control the optional kwargs —
  omitted entirely when falsy, which is what keeps output byte-identical for
  the actions that never passed them.
#}
{% macro shot(step, action, when, selector=None, bbox=False, highlight=False) -%}
{% if step | emits_screenshot and ((when == "before") == (step.screenshot_when == "before")) %}
    take_screenshot_with_bbox({{ step.role }}_page, SCENARIO, {{ step.step_number }}, "{{ action }}"{% if selector is not none %}, selector={{ selector | pystr }}{% endif %}{% if bbox %}, precaptured_bbox=_bbox{% endif %}{% if highlight %}, highlight=True{% endif %})
{% endif %}
{%- endmacro %}
